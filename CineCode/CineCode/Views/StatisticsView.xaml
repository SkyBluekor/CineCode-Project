<UserControl
    x:Class="CineCode.Views.StatisticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="756"
    d:DesignWidth="1000"
    FontFamily="/Fonts/#Pretendard"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  통계 화면에서 공통으로 사용하는 카드, 필터, 표 스타일을 정의합니다.  -->
        <!--  상단 통계 요약 카드 스타일  -->
        <Style
            x:Key="SummaryCardStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="18" />
            <Setter
                Property="Padding"
                Value="16" />
            <Setter
                Property="BorderBrush"
                Value="#E7E1F1" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <!--  차트와 표 영역을 감싸는 메인 카드 스타일  -->
        <Style
            x:Key="MainCardStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="18" />
            <Setter
                Property="Padding"
                Value="16" />
            <Setter
                Property="BorderBrush"
                Value="#E7E1F1" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <!--  검색어 입력과 필터 ComboBox를 감싸는 박스 스타일  -->
        <Style
            x:Key="FilterBoxStyle"
            TargetType="Border">
            <Setter
                Property="Height"
                Value="38" />
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="10" />
            <Setter
                Property="BorderBrush"
                Value="#DED8EA" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="10,0" />
        </Style>
        <!--  필터 입력 TextBox 스타일  -->
        <Style
            x:Key="CleanTextBoxStyle"
            TargetType="TextBox">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
            <Setter
                Property="CaretBrush"
                Value="#6D5DF6" />
        </Style>
        <!--  필터 선택 ComboBox 스타일  -->
        <Style
            x:Key="CleanComboBoxStyle"
            TargetType="ComboBox">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
        </Style>
        <!--  통계 화면 버튼 공통 스타일  -->
        <Style
            x:Key="ActionButtonStyle"
            TargetType="Button">
            <Setter
                Property="Height"
                Value="38" />
            <Setter
                Property="MinWidth"
                Value="0" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.88" />
                            </Trigger>
                            <Trigger
                                Property="IsEnabled"
                                Value="False">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#ECEAF1" />
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#ECEAF1" />
                                <Setter
                                    Property="Foreground"
                                    Value="#AAA4B5" />
                                <Setter
                                    Property="Cursor"
                                    Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  통계 목록 DataGrid 공통 스타일  -->
        <Style
            x:Key="StatisticsDataGridStyle"
            TargetType="DataGrid">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="BorderBrush"
                Value="#E4DEEF" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="MinRowHeight"
                Value="42" />
            <Setter
                Property="HeadersVisibility"
                Value="Column" />
            <Setter
                Property="GridLinesVisibility"
                Value="Horizontal" />
            <Setter
                Property="HorizontalGridLinesBrush"
                Value="#EEEAF5" />
            <Setter
                Property="VerticalGridLinesBrush"
                Value="#EEEAF5" />
            <Setter
                Property="CanUserAddRows"
                Value="False" />
            <Setter
                Property="CanUserDeleteRows"
                Value="False" />
            <Setter
                Property="CanUserResizeRows"
                Value="False" />
            <Setter
                Property="AutoGenerateColumns"
                Value="False" />
            <Setter
                Property="IsReadOnly"
                Value="True" />
            <Setter
                Property="SelectionMode"
                Value="Single" />
            <Setter
                Property="SelectionUnit"
                Value="FullRow" />
            <Setter
                Property="FontSize"
                Value="12" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
        </Style>
        <!--  DataGrid 헤더 스타일  -->
        <Style TargetType="DataGridColumnHeader">
            <Setter
                Property="Height"
                Value="40" />
            <Setter
                Property="Background"
                Value="#F5F2FB" />
            <Setter
                Property="Foreground"
                Value="#5F5870" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="FontSize"
                Value="12" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Center" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="BorderBrush"
                Value="#E4DEEF" />
            <Setter
                Property="BorderThickness"
                Value="0,0,1,1" />
        </Style>
        <!--  DataGrid 셀 스타일  -->
        <Style TargetType="DataGridCell">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="TextBlock.TextAlignment"
                Value="Center" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="Padding"
                Value="4,0" />
        </Style>
        <!--  가운데 정렬 셀 텍스트 스타일  -->
        <Style
            x:Key="CenterCellTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="TextAlignment"
                Value="Center" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
            <Setter
                Property="Padding"
                Value="4,3" />
        </Style>
        <!--  왼쪽 정렬 셀 텍스트 스타일  -->
        <Style
            x:Key="LeftCellTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="TextAlignment"
                Value="Left" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
            <Setter
                Property="Padding"
                Value="8,3" />
        </Style>
    </UserControl.Resources>
    <Grid Background="#F8F9FC">
        <Grid Margin="28">
            <!--  =========================  -->
            <!--  1. Statistics 메인 화면  -->
            <!--  =========================  -->
            <Grid
                x:Name="StatisticsMainPanel"
                Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  제목  -->
                <StackPanel Grid.Row="0">
                    <TextBlock
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="#1E192D"
                        Text="Statistics" />
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="14"
                        Foreground="#777184"
                        Text="서비스 및 콘텐츠 통계 데이터를 분석하고 인사이트를 확인합니다." />
                </StackPanel>
                <!--  요약 카드  -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  총 사용자  -->
                    <Border
                        Grid.Column="0"
                        Style="{StaticResource SummaryCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="50"
                                Height="50"
                                Background="#EEF3FF"
                                CornerRadius="14">
                                <Image
                                    Width="45"
                                    Height="45"
                                    Source="/Images/StatisticsIcon/StatisticsTotalUser.png"
                                    Stretch="Uniform" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#6B6380"
                                    Text="시청 사용자" />
                                <TextBlock
                                    x:Name="TotalUserCountText"
                                    Margin="0,4,0,0"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="#1E192D"
                                    Text="0" />
                                <TextBlock
                                    x:Name="TotalUserCompareText"
                                    FontSize="12"
                                    Foreground="#3B82F6"
                                    Text="전월 대비 +0.00%" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!--  총 시청 시간  -->
                    <Border
                        Grid.Column="2"
                        Style="{StaticResource SummaryCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="50"
                                Height="50"
                                Background="#F4EEFF"
                                CornerRadius="14">
                                <Image
                                    Width="45"
                                    Height="45"
                                    Source="/Images/StatisticsIcon/StatisticsTotalWatchTIme.png"
                                    Stretch="Uniform" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#6B6380"
                                    Text="총 시청 시간" />
                                <TextBlock
                                    x:Name="TotalWatchTimeText"
                                    Margin="0,4,0,0"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="#1E192D"
                                    Text="0 시간" />
                                <TextBlock
                                    x:Name="TotalWatchTimeCompareText"
                                    FontSize="12"
                                    Foreground="#7B4DF6"
                                    Text="전월 대비 +0.00%" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!--  평균 평점  -->
                    <Border
                        Grid.Column="4"
                        Style="{StaticResource SummaryCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="50"
                                Height="50"
                                Background="#FFEFF3"
                                CornerRadius="14">
                                <Image
                                    Width="45"
                                    Height="45"
                                    Source="/Images/StatisticsIcon/StatisticsAvgScore.png"
                                    Stretch="Uniform" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#6B6380"
                                    Text="평균 평점" />
                                <TextBlock
                                    x:Name="AverageRatingText"
                                    Margin="0,4,0,0"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="#1E192D"
                                    Text="0.0 / 5" />
                                <TextBlock
                                    x:Name="AverageRatingCompareText"
                                    FontSize="12"
                                    Foreground="#F05D7A"
                                    Text="전월 대비 +0.00" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!--  활성 구독률  -->
                    <Border
                        Grid.Column="6"
                        Style="{StaticResource SummaryCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="50"
                                Height="50"
                                Background="#EEF3FF"
                                CornerRadius="14">
                                <Image
                                    Width="40"
                                    Height="40"
                                    Source="/Images/StatisticsIcon/StatisticsActiveSub.png"
                                    Stretch="Uniform" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#6B6380"
                                    Text="활성 구독률" />
                                <TextBlock
                                    x:Name="ActiveSubscriptionRateText"
                                    Margin="0,4,0,0"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="#1E192D"
                                    Text="0.0%" />
                                <TextBlock
                                    x:Name="ActiveSubscriptionCompareText"
                                    FontSize="12"
                                    Foreground="#3B82F6"
                                    Text="전월 대비 +0.00%" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <!--  필터  -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="135" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Style="{StaticResource FilterBoxStyle}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#5F5870"
                            Text="기간 선택" />
                    </Border>
                    <Border
                        Grid.Column="2"
                        Style="{StaticResource FilterBoxStyle}">
                        <ComboBox
                            x:Name="StatisticsPeriodComboBox"
                            SelectedIndex="0"
                            DisplayMemberPath="DisplayText"
                            SelectionChanged="StatisticsFilter_SelectionChanged"
                            Style="{StaticResource CleanComboBoxStyle}" />
                    </Border>
                    <Border
                        Grid.Column="4"
                        Style="{StaticResource FilterBoxStyle}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#5F5870"
                            Text="비교 기간" />
                    </Border>
                    <Border
                        Grid.Column="6"
                        Style="{StaticResource FilterBoxStyle}">
                        <ComboBox
                            x:Name="ComparePeriodComboBox"
                            SelectedIndex="0"
                            Style="{StaticResource CleanComboBoxStyle}">
                            <ComboBoxItem Content="전월 대비" />
                            <ComboBoxItem Content="전분기 대비" />
                            <ComboBoxItem Content="전년 대비" />
                        </ComboBox>
                    </Border>
                    <Border
                        Grid.Column="8"
                        Style="{StaticResource FilterBoxStyle}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#5F5870"
                            Text="콘텐츠 유형" />
                    </Border>
                    <Border
                        Grid.Column="10"
                        Style="{StaticResource FilterBoxStyle}">
                        <ComboBox
                            x:Name="StatisticsContentTypeComboBox"
                            SelectedIndex="0"
                            SelectionChanged="StatisticsFilter_SelectionChanged"
                            Style="{StaticResource CleanComboBoxStyle}">
                            <ComboBoxItem Content="전체" />
                            <ComboBoxItem Content="MOVIE" />
                            <ComboBoxItem Content="TV" />
                        </ComboBox>
                    </Border>
                </Grid>
                <!--  본문  -->
                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.05*" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <!--  월별 시청 활동 추이  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource MainCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="월별 시청 활동 추이" />
                            <Grid
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                ClipToBounds="True">
                                <Viewbox Stretch="Fill">
                                    <Grid
                                        Width="560"
                                        Height="170">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="150" />
                                            <RowDefinition Height="20" />
                                        </Grid.RowDefinitions>
                                        <Canvas
                                            x:Name="MonthlyWatchActivityChartCanvas"
                                            Grid.Row="0"
                                            Width="560"
                                            Height="150">
                                            <!-- 가이드 라인 -->
                                            <Line
                                                X1="20"
                                                Y1="30"
                                                X2="540"
                                                Y2="30"
                                                Stroke="#EEEAF5" />
                                            <Line
                                                X1="20"
                                                Y1="70"
                                                X2="540"
                                                Y2="70"
                                                Stroke="#EEEAF5" />
                                            <Line
                                                X1="20"
                                                Y1="110"
                                                X2="540"
                                                Y2="110"
                                                Stroke="#EEEAF5" />
                                            <Line
                                                X1="20"
                                                Y1="145"
                                                X2="540"
                                                Y2="145"
                                                Stroke="#EEEAF5" />
                                            <!-- 총 시청 시간 -->
                                            <Polyline
                                                x:Name="MonthlyWatchActivityPolyline"
                                                Stroke="#9B5DF6"
                                                StrokeThickness="3" />
                                        </Canvas>
                                        <ItemsControl
                                            x:Name="MonthlyWatchActivityMonthLabelsItemsControl"
                                            Grid.Row="1"
                                            Margin="20,0,20,0"
                                            HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Text="{Binding ShortMonthText}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#6B6680"
                                                        HorizontalAlignment="Center"
                                                        TextAlignment="Center" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Grid>
                    </Border>
                    <!--  장르별 인기 순위  -->
                    <Border
                        Grid.Row="0"
                        Grid.Column="2"
                        Style="{StaticResource MainCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="장르별 인기 순위" />
                            <ItemsControl
                                x:Name="GenrePopularityItemsControl"
                                Grid.Row="1"
                                Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="55" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Foreground="#6D5DF6"
                                                Text="{Binding Rank}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="#1E192D"
                                                Text="{Binding GenreName}" />
                                            <ProgressBar
                                                Grid.Column="2"
                                                Height="8"
                                                Maximum="100"
                                                Value="{Binding BarPercent}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Foreground="#5F5870"
                                                Text="{Binding ShareRateText}"
                                                TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <!--  OTT 플랫폼 점유율  -->
                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource MainCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="OTT 플랫폼 점유율" />
                            <Grid
                                Grid.Row="1"
                                Margin="0,14,0,0"
                                ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.78*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="1.22*" />
                                </Grid.ColumnDefinitions>
                                <!-- 도넛 차트 -->
                                <Viewbox
                                    Grid.Column="0"
                                    MaxWidth="175"
                                    MaxHeight="175"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    StretchDirection="DownOnly">
                                    <Grid
                                        Width="190"
                                        Height="190">
                                        <Canvas
                                            x:Name="OttPlatformShareDonutCanvas"
                                            Width="190"
                                            Height="190" />
                                        <Ellipse
                                            Width="76"
                                            Height="76"
                                            Fill="White"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <StackPanel
                                            Width="76"
                                            Height="76"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Margin="0,10,0,0"
                                                Width="76"
                                                FontSize="12"
                                                Foreground="#1E192D"
                                                Text="총 시청 시간"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                x:Name="OttTotalWatchHoursText"
                                                Margin="0,4,0,0"
                                                Width="76"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Foreground="#1E192D"
                                                Text="0"
                                                TextAlignment="Center" />
                                            <TextBlock
                                                Margin="0,1,0,0"
                                                Width="76"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#5F5870"
                                                Text="시간"
                                                TextAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Viewbox>
                                <!-- 범례 -->
                                <ItemsControl
                                    x:Name="OttPlatformShareLegendItemsControl"
                                    Grid.Column="2"
                                    VerticalAlignment="Center">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="62" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse
                                                    Grid.Column="0"
                                                    Width="9"
                                                    Height="9"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding ColorBrush}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,0,8,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#1E192D"
                                                    Text="{Binding OttName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="#1E192D"
                                                    Text="{Binding ShareRateText}"
                                                    TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                    <!--  TOP 5 콘텐츠  -->
                    <Border
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource MainCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--  제목 + 전체 보기  -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Foreground="#1E192D"
                                    Text="TOP 5 콘텐츠" />
                                <Button
                                    x:Name="ShowTopContentFullButton"
                                    Grid.Column="1"
                                    Width="100"
                                    Height="30"
                                    Background="White"
                                    BorderBrush="#D7CEF0"
                                    Click="ShowTopContentFullButton_Click"
                                    Content="전체 순위 보기"
                                    Foreground="#6D5DF6"
                                    Style="{StaticResource ActionButtonStyle}" />
                            </Grid>
                            <!--  TOP 5 표  -->
                            <Grid
                                Grid.Row="1"
                                Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- 헤더 -->
                                <Border
                                    Grid.Row="0"
                                    Background="#F3EFFB"
                                    BorderBrush="#E2DCEF"
                                    BorderThickness="1,1,1,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="65" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="순위"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#5F5870"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="콘텐츠"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#5F5870"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="시청횟수"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#5F5870"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="시청시간"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#5F5870"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Text="평점"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="#5F5870"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            TextAlignment="Center" />
                                    </Grid>
                                </Border>
                                <!-- 데이터 -->
                                <ItemsControl
                                    x:Name="TopContentItemsControl"
                                    Grid.Row="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Height="32"
                                                Background="White"
                                                BorderBrush="#E2DCEF"
                                                BorderThickness="1,0,1,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="65" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{Binding Rank}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#1E192D"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding Title}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#1E192D"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{Binding WatchCountText}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#1E192D"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center" />
                                                    <TextBlock
                                                        Grid.Column="3"
                                                        Text="{Binding TotalWatchHoursText}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#1E192D"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center" />
                                                    <TextBlock
                                                        Grid.Column="4"
                                                        Text="{Binding AverageRatingScoreText}"
                                                        FontSize="12"
                                                        FontWeight="SemiBold"
                                                        Foreground="#1E192D"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <!--  =========================  -->
            <!--  2. TOP 콘텐츠 전체보기 화면  -->
            <!--  =========================  -->
            <Grid
                x:Name="TopContentFullPanel"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  제목  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="92" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="30"
                            FontWeight="Bold"
                            Foreground="#1E192D"
                            Text="TOP 콘텐츠 전체 순위" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="#777184"
                            Text="시청 시간 기준으로 콘텐츠 전체 순위를 조회합니다." />
                    </StackPanel>
                    <Button
                        x:Name="BackToStatisticsMainButton"
                        Grid.Column="1"
                        Width="92"
                        Background="White"
                        BorderBrush="#CFC8DC"
                        Click="BackToStatisticsMainButton_Click"
                        Content="목록으로"
                        Foreground="#5F5870"
                        Style="{StaticResource ActionButtonStyle}" />
                </Grid>
                <!--  필터  -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Style="{StaticResource FilterBoxStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#9B94A8"
                                Text="🔍" />
                            <TextBox
                                x:Name="TopContentSearchTextBox"
                                Grid.Column="1"
                                KeyDown="TopContentSearchTextBox_KeyDown"
                                Style="{StaticResource CleanTextBoxStyle}" />
                        </Grid>
                    </Border>
                    <Border
                        Grid.Column="2"
                        Style="{StaticResource FilterBoxStyle}">
                        <ComboBox
                            x:Name="TopContentTypeFilterComboBox"
                            DisplayMemberPath="DisplayText"
                            SelectionChanged="TopContentTypeFilterComboBox_SelectionChanged"
                            Style="{StaticResource CleanComboBoxStyle}" />
                    </Border>
                    <Border
                        Grid.Column="4"
                        Style="{StaticResource FilterBoxStyle}">
                        <ComboBox
                            x:Name="TopContentOttFilterComboBox"
                            DisplayMemberPath="DisplayText"
                            SelectionChanged="TopContentFilter_SelectionChanged"
                            Style="{StaticResource CleanComboBoxStyle}" />
                    </Border>
                    <Border
                        Grid.Column="6"
                        Style="{StaticResource FilterBoxStyle}">
                        <ComboBox
                            x:Name="TopContentGenreFilterComboBox"
                            DisplayMemberPath="DisplayText"
                            SelectionChanged="TopContentFilter_SelectionChanged"
                            Style="{StaticResource CleanComboBoxStyle}" />
                    </Border>
                </Grid>
                <!--  전체 순위 DataGrid  -->
                <Border
                    Grid.Row="4"
                    Style="{StaticResource MainCardStyle}">
                    <DataGrid
                        x:Name="TopContentFullDataGrid"
                        AutoGenerateColumns="False"
                        Style="{StaticResource StatisticsDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="60"
                                Binding="{Binding Rank}"
                                ElementStyle="{StaticResource CenterCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="순위" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn
                                Width="2*"
                                MinWidth="220">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="콘텐츠" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                Width="40"
                                                Height="52"
                                                Background="#EEEAF5"
                                                CornerRadius="6">
                                                <Image
                                                    Width="40"
                                                    Height="52"
                                                    Source="{Binding PosterUrl}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="#1E192D"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    FontSize="11"
                                                    Foreground="#8A8398"
                                                    Text="{Binding ContentTypeText}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding OttNames}"
                                ElementStyle="{StaticResource CenterCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="OTT" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding GenreNames}"
                                ElementStyle="{StaticResource CenterCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="장르" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="130"
                                Binding="{Binding TotalWatchTimeText}"
                                ElementStyle="{StaticResource CenterCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="총 시청 시간" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding ViewerCountText}"
                                ElementStyle="{StaticResource CenterCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="시청자 수" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding AverageRatingScoreText}"
                                ElementStyle="{StaticResource CenterCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="평균 평점" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding CompletionRateText}"
                                ElementStyle="{StaticResource CenterCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="완료율" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
