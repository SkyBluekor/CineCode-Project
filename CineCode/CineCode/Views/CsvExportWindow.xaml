<Window
    x:Class="CineCode.Views.CsvExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CSV 추출"
    Width="520"
    Height="500"
    Background="#F8F9FC"
    FontFamily="/Fonts/#Pretendard"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Border
        Margin="24"
        Padding="24"
        Background="White"
        BorderBrush="#E4DDF2"
        BorderThickness="1"
        CornerRadius="18">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 제목 -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="26"
                    FontWeight="Bold"
                    Foreground="#1E192D"
                    Text="CSV 추출" />

                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="14"
                    Foreground="#6F687D"
                    Text="추출할 데이터를 선택하세요." />
            </StackPanel>

            <!-- 추출 버튼 목록 -->
            <UniformGrid
                Grid.Row="2"
                Columns="1"
                Rows="5">

                <Button
                    Height="45"
                    Margin="0,0,0,10"
                    Background="#EEF6FF"
                    BorderBrush="#CFE3FF"
                    Click="CsvExportButton_Click"
                    Content="전체 사용자 추출"
                    FontWeight="Bold"
                    Foreground="#2563EB"
                    Tag="TotalUsers" />

                <Button
                    Height="45"
                    Margin="0,0,0,10"
                    Background="#F3EFFF"
                    BorderBrush="#DCD2FF"
                    Click="CsvExportButton_Click"
                    Content="전체 콘텐츠 추출"
                    FontWeight="Bold"
                    Foreground="#6D5DF6"
                    Tag="TotalContent" />

                <Button
                    Height="45"
                    Margin="0,0,0,10"
                    Background="#F6F0FF"
                    BorderBrush="#E1D3FF"
                    Click="CsvExportButton_Click"
                    Content="장르 추출"
                    FontWeight="Bold"
                    Foreground="#7C3AED"
                    Tag="Genre" />

                <Button
                    Height="45"
                    Margin="0,0,0,10"
                    Background="#EFFFF7"
                    BorderBrush="#CFF5E2"
                    Click="CsvExportButton_Click"
                    Content="OTT 제공자 추출"
                    FontWeight="Bold"
                    Foreground="#16A34A"
                    Tag="OttProvider" />

                <Button
                    Height="45"
                    Margin="0,0,0,0"
                    Background="#FFF5EF"
                    BorderBrush="#FFD9C2"
                    Click="CsvExportButton_Click"
                    Content="시청 기록 추출"
                    FontWeight="Bold"
                    Foreground="#EA580C"
                    Tag="WatchHistory" />
            </UniformGrid>

            <!-- 하단 버튼 -->
            <Grid Grid.Row="4">
                <Button
                    Width="90"
                    Height="38"
                    HorizontalAlignment="Right"
                    Background="White"
                    BorderBrush="#CFC8DC"
                    Click="CloseButton_Click"
                    Content="닫기"
                    FontWeight="Bold"
                    Foreground="#5F5870" />
            </Grid>
        </Grid>
    </Border>
</Window>
