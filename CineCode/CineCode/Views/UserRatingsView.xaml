<UserControl
    x:Class="CineCode.Views.UserRatingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CineCode.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="756"
    d:DesignWidth="1000"
    FontFamily="/Fonts/#Pretendard"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  사용자 평점 화면에서 공통으로 사용하는 카드, 필터, 버튼, 표, 입력 폼 스타일을 정의합니다.  -->
        <!--  상단 평점 현황 요약 카드 스타일  -->
        <Style
            x:Key="SummaryCardStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="18" />
            <Setter
                Property="Padding"
                Value="16" />
            <Setter
                Property="BorderBrush"
                Value="#E7E1F1" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <!--  평가 목록, 등록, 수정 화면을 감싸는 메인 카드 스타일  -->
        <Style
            x:Key="MainCardStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="18" />
            <Setter
                Property="Padding"
                Value="14" />
            <Setter
                Property="BorderBrush"
                Value="#E7E1F1" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <!--  검색어 입력, 필터, 평가 등록/수정 입력칸을 감싸는 박스 스타일  -->
        <Style
            x:Key="FilterBoxStyle"
            TargetType="Border">
            <Setter
                Property="Height"
                Value="38" />
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="10" />
            <Setter
                Property="BorderBrush"
                Value="#DED8EA" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="10,0" />
        </Style>
        <!--  기본 테두리를 제거한 입력 TextBox 스타일  -->
        <Style
            x:Key="CleanTextBoxStyle"
            TargetType="TextBox">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
            <Setter
                Property="CaretBrush"
                Value="#6D5DF6" />
        </Style>
        <!--  필터와 평점 선택에 사용하는 ComboBox 스타일  -->
        <Style
            x:Key="CleanComboBoxStyle"
            TargetType="ComboBox">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
        </Style>
        <!--  평가일 입력 DatePicker 스타일  -->
        <Style
            x:Key="CleanDatePickerStyle"
            TargetType="DatePicker">
            <Setter
                Property="Height"
                Value="38" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="BorderBrush"
                Value="#DED8EA" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Background"
                Value="White" />
        </Style>
        <!--  조회, 등록, 수정, 삭제 버튼 공통 스타일  -->
        <Style
            x:Key="ActionButtonStyle"
            TargetType="Button">
            <Setter
                Property="Height"
                Value="38" />
            <Setter
                Property="MinWidth"
                Value="0" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.88" />
                            </Trigger>
                            <Trigger
                                Property="IsEnabled"
                                Value="False">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#ECEAF1" />
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#ECEAF1" />
                                <Setter
                                    Property="Foreground"
                                    Value="#AAA4B5" />
                                <Setter
                                    Property="Cursor"
                                    Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  사용자 평점 목록 DataGrid 스타일  -->
        <Style
            x:Key="UserRatingDataGridStyle"
            TargetType="DataGrid">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="BorderBrush"
                Value="#E4DEEF" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="MinRowHeight"
                Value="42" />
            <Setter
                Property="HeadersVisibility"
                Value="Column" />
            <Setter
                Property="GridLinesVisibility"
                Value="Horizontal" />
            <Setter
                Property="HorizontalGridLinesBrush"
                Value="#EEEAF5" />
            <Setter
                Property="VerticalGridLinesBrush"
                Value="#EEEAF5" />
            <Setter
                Property="CanUserAddRows"
                Value="False" />
            <Setter
                Property="CanUserDeleteRows"
                Value="False" />
            <Setter
                Property="CanUserResizeRows"
                Value="False" />
            <Setter
                Property="AutoGenerateColumns"
                Value="False" />
            <Setter
                Property="IsReadOnly"
                Value="True" />
            <Setter
                Property="SelectionMode"
                Value="Single" />
            <Setter
                Property="SelectionUnit"
                Value="FullRow" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
            <Setter
                Property="HorizontalScrollBarVisibility"
                Value="Auto" />
            <Setter
                Property="VerticalScrollBarVisibility"
                Value="Auto" />
        </Style>
        <!--  DataGrid 헤더 스타일  -->
        <Style TargetType="DataGridColumnHeader">
            <Setter
                Property="Height"
                Value="40" />
            <Setter
                Property="Background"
                Value="#F5F2FB" />
            <Setter
                Property="Foreground"
                Value="#5F5870" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="FontSize"
                Value="12" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Center" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="BorderBrush"
                Value="#E4DEEF" />
            <Setter
                Property="BorderThickness"
                Value="0,0,1,1" />
        </Style>
        <!--  DataGrid 셀 스타일  -->
        <Style TargetType="DataGridCell">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="TextBlock.TextAlignment"
                Value="Center" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="Padding"
                Value="4,0" />
        </Style>
        <!--  가운데 정렬 셀 텍스트 스타일  -->
        <Style
            x:Key="CenterCellTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="TextAlignment"
                Value="Center" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
            <Setter
                Property="Padding"
                Value="4,3" />
        </Style>
        <!--  왼쪽 정렬 셀 텍스트 스타일  -->
        <Style
            x:Key="LeftCellTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="TextAlignment"
                Value="Left" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
            <Setter
                Property="Padding"
                Value="8,3" />
        </Style>
        <!--  평가 등록/수정 입력 폼 라벨 스타일  -->
        <Style
            x:Key="FormLabelStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="#5F5870" />
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
        </Style>
        <!--  수정할 수 없는 평가 관련 값 표시 스타일  -->
        <Style
            x:Key="ReadOnlyValueTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
        </Style>
    </UserControl.Resources>
    <!--  사용자 평점 관리 화면 전체 배경 영역  -->
    <Grid Background="#F8F9FC">
        <!--  제목, 요약 카드, 필터, 본문 카드를 배치하는 컨테이너  -->
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  제목  -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#1E192D"
                    Text="User Ratings" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="14"
                    Foreground="#777184"
                    Text="사용자 평점 정보를 조회하고 관리합니다." />
            </StackPanel>
            <!--  요약 카드  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  총 평가수  -->
                <Border
                    Grid.Column="0"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#F2ECFF"
                            CornerRadius="14">
                            <Image
                                Width="40"
                                Height="40"
                                Source="/Images/UserRatingsIcon/TotalRatings.png"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#6B6380"
                                Text="총 평가수"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Name="TotalRatingCountText"
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="0"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!--  평균 평점  -->
                <Border
                    Grid.Column="2"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#EEF3FF"
                            CornerRadius="14">
                            <Image
                                Width="40"
                                Height="40"
                                Source="/Images/UserRatingsIcon/AvgRatings.png"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#6B6380"
                                Text="평균 평점"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Name="AverageRatingScoreText"
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="0.0 / 5"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!--  고평점 콘텐츠  -->
                <Border
                    Grid.Column="4"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#EFFFF6"
                            CornerRadius="14">
                            <Image
                                Width="40"
                                Height="40"
                                Source="/Images/UserRatingsIcon/HighRatings.png"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#6B6380"
                                Text="고평점 콘텐츠"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Name="HighRatingContentText"
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="0"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!--  평가 대기  -->
                <Border
                    Grid.Column="6"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="50"
                            Height="50"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#FFF3E8"
                            CornerRadius="14">
                            <Image
                                Width="40"
                                Height="40"
                                Source="/Images/UserRatingsIcon/RatingsSoon.png"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#6B6380"
                                Text="평가 대기"
                                TextAlignment="Center" />
                            <TextBlock
                                x:Name="PendingRatingCountText"
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="0"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!--  검색 필터 상단 버튼  -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="135" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <!--  검색  -->
                <Border
                    Grid.Column="0"
                    Style="{StaticResource FilterBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#A8DADC"
                            Text="🔍" />
                        <TextBox
                            x:Name="UserRatingSearchTextBox"
                            Grid.Column="1"
                            Style="{StaticResource CleanTextBoxStyle}"
                            TextChanged="UserRatingSearchTextBox_TextChanged" />
                    </Grid>
                </Border>
                <!--  평점 필터  -->
                <Border
                    Grid.Column="2"
                    Style="{StaticResource FilterBoxStyle}">
                    <ComboBox
                        x:Name="UserRatingScoreFilterComboBox"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        SelectedIndex="0"
                        SelectionChanged="UserRatingFilterComboBox_SelectionChanged"
                        Style="{StaticResource CleanComboBoxStyle}">
                        <ComboBoxItem Content="평점 전체" />
                        <ComboBoxItem Content="5점 이상" />
                        <ComboBoxItem Content="4점 이상" />
                        <ComboBoxItem Content="3점 이상" />
                        <ComboBoxItem Content="3점 미만" />
                    </ComboBox>
                </Border>
                <!--  콘텐츠 타입 필터  -->
                <Border
                    Grid.Column="4"
                    Style="{StaticResource FilterBoxStyle}">
                    <ComboBox
                        x:Name="UserRatingTypeFilterComboBox"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        SelectedIndex="0"
                        SelectionChanged="UserRatingFilterComboBox_SelectionChanged"
                        Style="{StaticResource CleanComboBoxStyle}">
                        <ComboBoxItem Content="타입 전체" />
                        <ComboBoxItem Content="MOVIE" />
                        <ComboBoxItem Content="TV" />
                    </ComboBox>
                </Border>
                <!--  평가월 필터  -->
                <Border
                    Grid.Column="6"
                    Style="{StaticResource FilterBoxStyle}">
                    <ComboBox
                        x:Name="UserRatingMonthFilterComboBox"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        SelectedIndex="0"
                        SelectionChanged="UserRatingFilterComboBox_SelectionChanged"
                        Style="{StaticResource CleanComboBoxStyle}">
                        <ComboBoxItem Content="전체 기간" />
                    </ComboBox>
                </Border>
                <!--  평가 등록  -->
                <Button
                    x:Name="AddRatingButton"
                    Grid.Column="8"
                    Width="100"
                    Background="#6D5DF6"
                    BorderBrush="#6D5DF6"
                    Click="AddRatingButton_Click"
                    Content="+ 평가"
                    Foreground="White"
                    Style="{StaticResource ActionButtonStyle}" />
                <!--  CSV  -->
                <Button
                    x:Name="ExportRatingCsvButton"
                    Grid.Column="10"
                    Width="74"
                    Background="White"
                    BorderBrush="#C8B8FF"
                    Click="ExportRatingCsvButton_Click"
                    Content="CSV 추출"
                    Foreground="#605DF6"
                    Style="{StaticResource ActionButtonStyle}" />
            </Grid>
            <!--  본문 카드  -->
            <Border
                Grid.Row="6"
                Style="{StaticResource MainCardStyle}">
                <Grid>
                    <!--  1. 평점 목록 화면  -->
                    <Grid
                        x:Name="RatingListPanel"
                        Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid
                            x:Name="UserRatingDataGrid"
                            Grid.Row="0"
                            SelectionChanged="UserRatingDataGrid_SelectionChanged"
                            Style="{StaticResource UserRatingDataGridStyle}">
                            <DataGrid.Columns>
                                <!--  사용자명  -->
                                <DataGridTextColumn
                                    Width="1.1*"
                                    MinWidth="120"
                                    Binding="{Binding User_Name}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="사용자명"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!--  콘텐츠명  -->
                                <DataGridTextColumn
                                    Width="1.8*"
                                    MinWidth="220"
                                    Binding="{Binding Content_Name}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="콘텐츠명"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!--  타입  -->
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding Content_Type}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="타입"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!--  평점  -->
                                <DataGridTextColumn
                                    Width="120"
                                    Binding="{Binding RatingScoreText, StringFormat={}{0} / 5}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="평점"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!--  시청률  -->
                                <DataGridTemplateColumn Width="150">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock
                                            Text="시청률"
                                            TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="44" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar
                                                    Grid.Column="0"
                                                    Height="7"
                                                    VerticalAlignment="Center"
                                                    Maximum="100"
                                                    Minimum="0"
                                                    Value="{Binding Progress_Percentage, TargetNullValue=0}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#5F5870"
                                                    Text="{Binding ProgressPercentText}"
                                                    TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--  평가일  -->
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding RatedAtText}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="평가일"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!--  하단 버튼  -->
                        <StackPanel
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                x:Name="EditRatingButton"
                                Width="84"
                                Background="White"
                                BorderBrush="#BFAEFF"
                                Click="EditRatingButton_Click"
                                Content="수정"
                                Foreground="#6D5DF6"
                                IsEnabled="False"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                x:Name="DeleteRatingButton"
                                Width="84"
                                Margin="8,0,0,0"
                                Background="White"
                                BorderBrush="#FFB8C8"
                                Click="DeleteRatingButton_Click"
                                Content="삭제"
                                Foreground="#D9365B"
                                IsEnabled="False"
                                Style="{StaticResource ActionButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <!--  =========================  -->
                    <!--  2. 평가 등록 화면  -->
                    <!--  =========================  -->
                    <Grid
                        x:Name="RatingAddPanel"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  제목  -->
                        <StackPanel Grid.Row="0">
                            <TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="평가 등록" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="14"
                                Foreground="#777184"
                                Text="사용자와 콘텐츠를 선택한 뒤 평점을 등록합니다." />
                        </StackPanel>
                        <!--  1행: 사용자 검색 / 콘텐츠 선택 / 타입  -->
                        <Grid
                            Grid.Row="2"
                            HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1.8*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <!--  사용자 검색  -->
                            <Grid
                                Grid.Column="0"
                                HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="사용자 *" />
                                <Grid
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        Grid.Row="0"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource FilterBoxStyle}">
                                        <TextBox
                                            x:Name="AddRatingUserSearchTextBox"
                                            HorizontalAlignment="Stretch"
                                            Style="{StaticResource CleanTextBoxStyle}"
                                            TextChanged="AddRatingUserSearchTextBox_TextChanged"
                                            PreviewKeyDown="AddRatingUserSearchTextBox_PreviewKeyDown" />
                                    </Border>
                                    <ListBox
                                        x:Name="AddRatingUserSearchResultListBox"
                                        Grid.Row="1"
                                        Height="120"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberPath="DisplayText"
                                        Visibility="Collapsed"
                                        PreviewKeyDown="AddRatingUserSearchResultListBox_PreviewKeyDown"
                                        PreviewMouseLeftButtonUp="AddRatingUserSearchResultListBox_PreviewMouseLeftButtonUp" />
                                </Grid>
                            </Grid>
                            <!--  콘텐츠 선택  -->
                            <Grid
                                Grid.Column="2"
                                HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="콘텐츠 *" />
                                <Border
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource FilterBoxStyle}">
                                    <ComboBox
                                        x:Name="AddRatingContentComboBox"
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberPath="DisplayText"
                                        SelectedValuePath="Content_ID"
                                        SelectionChanged="AddRatingContentComboBox_SelectionChanged"
                                        Style="{StaticResource CleanComboBoxStyle}" />
                                </Border>
                            </Grid>
                            <!--  콘텐츠 타입  -->
                            <Grid
                                Grid.Column="4"
                                HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="콘텐츠 Type" />
                                <Border
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    Background="#F8F6FF"
                                    Style="{StaticResource FilterBoxStyle}">
                                    <TextBlock
                                        x:Name="AddRatingContentTypeText"
                                        Style="{StaticResource ReadOnlyValueTextStyle}"
                                        Text="-" />
                                </Border>
                            </Grid>
                        </Grid>
                        <!--  2행: 시청률 / 평점 / 평가일  -->
                        <Grid
                            Grid.Row="4"
                            HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  시청률  -->
                            <Grid
                                Grid.Column="0"
                                HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="시청률" />
                                <Border
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    Background="#F8F6FF"
                                    Style="{StaticResource FilterBoxStyle}">
                                    <TextBlock
                                        x:Name="AddRatingWatchProgressText"
                                        Style="{StaticResource ReadOnlyValueTextStyle}"
                                        Text="-" />
                                </Border>
                            </Grid>
                            <!--  평점  -->
                            <Grid
                                Grid.Column="2"
                                HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="평점 *" />
                                <Border
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource FilterBoxStyle}">
                                    <ComboBox
                                        x:Name="AddRatingScoreComboBox"
                                        HorizontalAlignment="Stretch"
                                        SelectedIndex="-1"
                                        Style="{StaticResource CleanComboBoxStyle}">
                                        <ComboBoxItem Content="5.0" />
                                        <ComboBoxItem Content="4.5" />
                                        <ComboBoxItem Content="4.0" />
                                        <ComboBoxItem Content="3.5" />
                                        <ComboBoxItem Content="3.0" />
                                        <ComboBoxItem Content="2.5" />
                                        <ComboBoxItem Content="2.0" />
                                        <ComboBoxItem Content="1.5" />
                                        <ComboBoxItem Content="1.0" />
                                        <ComboBoxItem Content="0.5" />
                                        <ComboBoxItem Content="0.0" />
                                    </ComboBox>
                                </Border>
                            </Grid>
                            <!--  평가일  -->
                            <Grid
                                Grid.Column="4"
                                HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Grid.Row="0"
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="평가일 *" />
                                <DatePicker
                                    x:Name="AddRatingDatePicker"
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Style="{StaticResource CleanDatePickerStyle}" />
                            </Grid>
                        </Grid>
                        <!--  하단 버튼  -->
                        <StackPanel
                            Grid.Row="6"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                x:Name="BackFromAddRatingButton"
                                Width="92"
                                Background="White"
                                BorderBrush="#CFC8DC"
                                Click="BackFromAddRatingButton_Click"
                                Content="목록으로"
                                Foreground="#5F5870"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                x:Name="ResetAddRatingFormButton"
                                Width="82"
                                Margin="8,0,0,0"
                                Background="White"
                                BorderBrush="#C8B8FF"
                                Click="ResetAddRatingFormButton_Click"
                                Content="초기화"
                                Foreground="#6D5DF6"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                x:Name="SaveAddRatingButton"
                                Width="92"
                                Margin="8,0,0,0"
                                Background="#6D5DF6"
                                BorderBrush="#6D5DF6"
                                Click="SaveAddRatingButton_Click"
                                Content="등록 저장"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <!--  =========================  -->
                    <!--  3. 평가 수정 화면  -->
                    <!--  =========================  -->
                    <Grid
                        x:Name="RatingEditPanel"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  제목  -->
                        <StackPanel Grid.Row="0">
                            <TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="평가 수정" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="14"
                                Foreground="#777184"
                                Text="선택한 평가의 평점과 평가일을 수정합니다." />
                        </StackPanel>
                        <!--  1행: 사용자 / 콘텐츠 / 타입  -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>
                            <!--  사용자  -->
                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="사용자" />
                                <Border
                                    Background="#F8F6FF"
                                    Style="{StaticResource FilterBoxStyle}">
                                    <TextBlock
                                        x:Name="EditRatingUserNameText"
                                        Style="{StaticResource ReadOnlyValueTextStyle}"
                                        Text="-" />
                                </Border>
                            </StackPanel>
                            <!--  콘텐츠  -->
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="콘텐츠" />
                                <Border
                                    Background="#F8F6FF"
                                    Style="{StaticResource FilterBoxStyle}">
                                    <TextBlock
                                        x:Name="EditRatingContentTitleText"
                                        Style="{StaticResource ReadOnlyValueTextStyle}"
                                        Text="-" />
                                </Border>
                            </StackPanel>
                            <!--  Type  -->
                            <StackPanel Grid.Column="4">
                                <TextBlock
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="콘텐츠 Type" />
                                <Border
                                    Background="#F8F6FF"
                                    Style="{StaticResource FilterBoxStyle}">
                                    <TextBlock
                                        x:Name="EditRatingContentTypeText"
                                        Style="{StaticResource ReadOnlyValueTextStyle}"
                                        Text="-" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <!--  2행: 시청률 / 평점 / 평가일  -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  시청률  -->
                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="시청률" />
                                <Border
                                    Background="#F8F6FF"
                                    Style="{StaticResource FilterBoxStyle}">
                                    <TextBlock
                                        x:Name="EditRatingWatchProgressText"
                                        Style="{StaticResource ReadOnlyValueTextStyle}"
                                        Text="-" />
                                </Border>
                            </StackPanel>
                            <!--  평점  -->
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="평점 *" />
                                <Border Style="{StaticResource FilterBoxStyle}">
                                    <ComboBox
                                        x:Name="EditRatingScoreComboBox"
                                        SelectedIndex="-1"
                                        Style="{StaticResource CleanComboBoxStyle}">
                                        <ComboBoxItem Content="5.0" />
                                        <ComboBoxItem Content="4.5" />
                                        <ComboBoxItem Content="4.0" />
                                        <ComboBoxItem Content="3.5" />
                                        <ComboBoxItem Content="3.0" />
                                        <ComboBoxItem Content="2.5" />
                                        <ComboBoxItem Content="2.0" />
                                        <ComboBoxItem Content="1.5" />
                                        <ComboBoxItem Content="1.0" />
                                        <ComboBoxItem Content="0.5" />
                                        <ComboBoxItem Content="0.0" />
                                    </ComboBox>
                                </Border>
                            </StackPanel>
                            <!--  평가일  -->
                            <StackPanel Grid.Column="4">
                                <TextBlock
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="평가일 *" />
                                <DatePicker
                                    x:Name="EditRatingDatePicker"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource CleanDatePickerStyle}" />
                            </StackPanel>
                        </Grid>
                        <!--  하단 버튼  -->
                        <StackPanel
                            Grid.Row="6"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                x:Name="BackFromEditRatingButton"
                                Width="92"
                                Background="White"
                                BorderBrush="#CFC8DC"
                                Click="BackFromEditRatingButton_Click"
                                Content="목록으로"
                                Foreground="#5F5870"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                x:Name="ResetEditRatingFormButton"
                                Width="82"
                                Margin="8,0,0,0"
                                Background="White"
                                BorderBrush="#C8B8FF"
                                Click="ResetEditRatingFormButton_Click"
                                Content="초기화"
                                Foreground="#6D5DF6"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                x:Name="SaveEditRatingButton"
                                Width="92"
                                Margin="8,0,0,0"
                                Background="#6D5DF6"
                                BorderBrush="#6D5DF6"
                                Click="SaveEditRatingButton_Click"
                                Content="수정 저장"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
