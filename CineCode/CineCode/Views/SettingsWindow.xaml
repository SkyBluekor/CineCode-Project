<Window
    x:Class="CineCode.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="환경 설정"
    Width="520"
    Height="500"
    Background="#F8F9FC"
    FontFamily="/Fonts/#Pretendard"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="BorderBrush" Value="#E7E1F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5F5870" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#DED8EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1E192D" />
            <Setter Property="CaretBrush" Value="#6D5DF6" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource SettingCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#1E192D"
                        Text="환경 설정" />

                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="13"
                        Foreground="#777184"
                        Text="CSV 저장 경로와 최소 평가 가능 시청률을 설정합니다." />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource LabelStyle}" Text="CSV 저장 경로" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InputBorderStyle}">
                            <TextBox x:Name="CsvExportPathTextBox" Style="{StaticResource CleanTextBoxStyle}" />
                        </Border>

                        <Button
                            x:Name="BrowseCsvPathButton"
                            Grid.Column="2"
                            Background="White"
                            BorderBrush="#C8B8FF"
                            Click="BrowseCsvPathButton_Click"
                            Content="찾기"
                            Foreground="#6D5DF6"
                            Style="{StaticResource ActionButtonStyle}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Style="{StaticResource LabelStyle}" Text="기본 구독 기간" />

                    <Border Background="#F8F6FF" Style="{StaticResource InputBorderStyle}">
                        <TextBlock
                            x:Name="DefaultSubscriptionDaysText"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#1E192D"
                            Text="30일" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="6">
                    <TextBlock Style="{StaticResource LabelStyle}" Text="최소 평가 가능 시청률" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InputBorderStyle}">
                            <TextBox x:Name="MinRatingProgressTextBox" Style="{StaticResource CleanTextBoxStyle}" />
                        </Border>

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#5F5870"
                            Text="%" />
                    </Grid>
                </StackPanel>

                <StackPanel
                    Grid.Row="8"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

                    <Button
                        x:Name="CancelButton"
                        Width="82"
                        Background="White"
                        BorderBrush="#CFC8DC"
                        Click="CancelButton_Click"
                        Content="취소"
                        Foreground="#5F5870"
                        Style="{StaticResource ActionButtonStyle}" />

                    <Button
                        x:Name="SaveButton"
                        Width="82"
                        Margin="8,0,0,0"
                        Background="#6D5DF6"
                        BorderBrush="#6D5DF6"
                        Click="SaveButton_Click"
                        Content="저장"
                        Foreground="White"
                        Style="{StaticResource ActionButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
