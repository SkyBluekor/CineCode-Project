<UserControl
    x:Class="CineCode.Views.ContentMappingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mapping="clr-namespace:CineCode.Views.ContentMapping"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="756"
    d:DesignWidth="1000"
    FontFamily="/Fonts/#Pretendard"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!-- 등록된 장르 카드 스타일 -->
        <Style x:Key="GenreSummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#E5D9FD" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderBrush" Value="#E5D9FD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- OTT 제공자 카드 스타일 -->
        <Style x:Key="OttSummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#D7E6FD" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderBrush" Value="#EDF5FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 매핑 누락 콘텐츠 카드 스타일 -->
        <Style x:Key="MissingSummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FDD9E4" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderBrush" Value="#FFF0F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 탭 버튼 공통 스타일 -->
        <Style x:Key="MappingTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#5F5870" />
            <Setter Property="BorderBrush" Value="#E1DAED" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F5F1FF" />
                            </Trigger>

                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#6D5DF6" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6D5DF6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F8F9FC">

        <!-- 실제 Content Mapping 화면 전체 여백 -->
        <Grid Margin="32,34,36,34">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 제목 -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="34"
                    FontWeight="Bold"
                    Foreground="#1E192D"
                    Text="Content Mapping" />

                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="16"
                    Foreground="#777184"
                    Text="장르, OTT 제공자, 콘텐츠 연결 정보를 관리합니다." />
            </StackPanel>

            <!-- 요약 카드 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 등록된 장르 -->
                <Border Grid.Column="0" Style="{StaticResource GenreSummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="58"
                            Height="58"
                            Source="/Images/ContentMappingIcon/TotalGenre.png"
                            Stretch="Uniform" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#777184"
                                Text="등록된 장르"
                                TextAlignment="Center" />

                            <TextBlock
                                x:Name="TotalGenreCountText"
                                Margin="0,6,0,0"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="0"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- OTT 제공자 -->
                <Border Grid.Column="2" Style="{StaticResource OttSummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="58"
                            Height="58"
                            Source="/Images/ContentMappingIcon/TotalOttProvider.png"
                            Stretch="Uniform" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#777184"
                                Text="OTT 제공자"
                                TextAlignment="Center" />

                            <TextBlock
                                x:Name="TotalOttProviderCountText"
                                Margin="0,6,0,0"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="0"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 매핑 누락 콘텐츠 -->
                <Border Grid.Column="4" Style="{StaticResource MissingSummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Image
                            Grid.Column="0"
                            Width="58"
                            Height="58"
                            Source="/Images/ContentMappingIcon/MissingMapping.png"
                            Stretch="Uniform" />

                        <StackPanel
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#777184"
                                Text="매핑 누락 콘텐츠"
                                TextAlignment="Center" />

                            <TextBlock
                                x:Name="MissingMappingCountText"
                                Margin="0,6,0,0"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="#D9365B"
                                Text="0"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 탭 버튼 -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="GenreTabButton"
                    Grid.Column="0"
                    Click="GenreTabButton_Click"
                    Content="Genre 관리"
                    Style="{StaticResource MappingTabButtonStyle}"
                    Tag="Selected" />

                <Button
                    x:Name="OttProviderTabButton"
                    Grid.Column="2"
                    Click="OttProviderTabButton_Click"
                    Content="OTT Provider 관리"
                    Style="{StaticResource MappingTabButtonStyle}" />

                <Button
                    x:Name="ContentRelationTabButton"
                    Grid.Column="4"
                    Click="ContentRelationTabButton_Click"
                    Content="콘텐츠 연결 관리"
                    Style="{StaticResource MappingTabButtonStyle}" />
            </Grid>

            <!-- 하위 화면 교체 영역 -->
            <ContentControl x:Name="MappingBodyArea" Grid.Row="6" />

        </Grid>
    </Grid>
</UserControl>
