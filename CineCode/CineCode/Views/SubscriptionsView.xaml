<UserControl
    x:Class="CineCode.Views.SubscriptionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="756"
    d:DesignWidth="1000"
    FontFamily="/Fonts/#Pretendard"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  구독 화면에서 공통으로 사용하는 카드, 필터, 버튼, 표 스타일을 정의합니다.  -->
        <!--  상단 구독 현황 요약 카드 스타일  -->
        <Style
            x:Key="SummaryCardStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="18" />
            <Setter
                Property="Padding"
                Value="20" />
            <Setter
                Property="BorderBrush"
                Value="#E7E1F1" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <!--  구독 목록과 구독 추가 화면을 감싸는 메인 카드 스타일  -->
        <Style
            x:Key="MainCardStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="18" />
            <Setter
                Property="Padding"
                Value="20" />
            <Setter
                Property="BorderBrush"
                Value="#E7E1F1" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <!--  검색어 입력, 필터, 구독 추가 입력칸을 감싸는 박스 스타일  -->
        <Style
            x:Key="FilterBoxStyle"
            TargetType="Border">
            <Setter
                Property="Height"
                Value="42" />
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="11" />
            <Setter
                Property="BorderBrush"
                Value="#DED8EA" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="12,0" />
        </Style>
        <!--  기본 테두리를 제거한 입력 TextBox 스타일  -->
        <Style
            x:Key="CleanTextBoxStyle"
            TargetType="TextBox">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
            <Setter
                Property="CaretBrush"
                Value="#6D5DF6" />
        </Style>
        <!--  필터와 선택 입력에 사용하는 ComboBox 스타일  -->
        <Style
            x:Key="CleanComboBoxStyle"
            TargetType="ComboBox">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
        </Style>
        <!--  조회, 추가, 저장 등 구독 화면 버튼 공통 스타일  -->
        <Style
            x:Key="ActionButtonStyle"
            TargetType="Button">
            <Setter
                Property="Height"
                Value="42" />
            <Setter
                Property="MinWidth"
                Value="110" />
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.88" />
                            </Trigger>
                            <Trigger
                                Property="IsEnabled"
                                Value="False">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#ECEAF1" />
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#ECEAF1" />
                                <Setter
                                    Property="Foreground"
                                    Value="#AAA4B5" />
                                <Setter
                                    Property="Cursor"
                                    Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  구독 목록 DataGrid 스타일  -->
        <Style
            x:Key="SubscriptionDataGridStyle"
            TargetType="DataGrid">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="BorderBrush"
                Value="#E4DEEF" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="MinRowHeight"
                Value="44" />
            <Setter
                Property="HeadersVisibility"
                Value="Column" />
            <Setter
                Property="GridLinesVisibility"
                Value="Horizontal" />
            <Setter
                Property="HorizontalGridLinesBrush"
                Value="#EEEAF5" />
            <Setter
                Property="VerticalGridLinesBrush"
                Value="#EEEAF5" />
            <Setter
                Property="CanUserAddRows"
                Value="False" />
            <Setter
                Property="CanUserDeleteRows"
                Value="False" />
            <Setter
                Property="CanUserResizeRows"
                Value="False" />
            <Setter
                Property="AutoGenerateColumns"
                Value="False" />
            <Setter
                Property="IsReadOnly"
                Value="True" />
            <Setter
                Property="SelectionMode"
                Value="Single" />
            <Setter
                Property="SelectionUnit"
                Value="FullRow" />
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
        </Style>
        <!--  DataGrid 헤더 스타일  -->
        <Style TargetType="DataGridColumnHeader">
            <Setter
                Property="Height"
                Value="42" />
            <Setter
                Property="Background"
                Value="#F5F2FB" />
            <Setter
                Property="Foreground"
                Value="#5F5870" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Center" />
            <Setter
                Property="BorderBrush"
                Value="#E4DEEF" />
            <Setter
                Property="BorderThickness"
                Value="0,0,1,1" />
        </Style>
        <!--  DataGrid 셀 스타일  -->
        <Style TargetType="DataGridCell">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="TextBlock.TextAlignment"
                Value="Center" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="Padding"
                Value="8,0" />
        </Style>
        <!--  가운데 정렬 셀 텍스트 스타일  -->
        <Style
            x:Key="CenterCellTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="TextAlignment"
                Value="Center" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
            <Setter
                Property="Padding"
                Value="8,4" />
        </Style>
        <!--  왼쪽 정렬 셀 텍스트 스타일  -->
        <Style
            x:Key="LeftCellTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="TextAlignment"
                Value="Left" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
            <Setter
                Property="Padding"
                Value="10,4" />
        </Style>
        <!--  구독 추가 입력 폼 라벨 스타일  -->
        <Style
            x:Key="FormLabelStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="#5F5870" />
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <!--  구독 관리 화면 전체 배경 영역  -->
    <Grid Background="#F8F9FC">
        <!--  제목, 요약 카드, 필터, 본문 카드를 배치하는 컨테이너  -->
        <Grid Margin="32,34,36,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!--  제목  -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="34"
                    FontWeight="Bold"
                    Foreground="#1E192D"
                    Text="Subscriptions" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="16"
                    Foreground="#777184"
                    Text="사용자의 월 구독 정보를 조회하고 관리합니다." />
            </StackPanel>
            <!--  요약 카드  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  활성 구독  -->
                <Border
                    Grid.Column="0"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="54"
                            Height="54"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#EEF3FF"
                            CornerRadius="18">
                            <Image
                                Width="40"
                                Height="40"
                                Source="/Images/SubscriptionIcon/TotalSub.png"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#6B6380"
                                TextAlignment="Center"
                                Text="활성 구독" />
                            <TextBlock
                                x:Name="ActiveSubscriptionCountText"
                                Margin="0,6,0,0"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                TextAlignment="Center"
                                Text="0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!--  만료 임박  -->
                <Border
                    Grid.Column="2"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="54"
                            Height="54"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#F4EEFF"
                            CornerRadius="18">
                            <Image
                                Width="40"
                                Height="40"
                                Source="/Images/SubscriptionIcon/Expiring_soon.png"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#6B6380"
                                TextAlignment="Center"
                                Text="만료 임박" />
                            <TextBlock
                                x:Name="ExpiringSoonCountText"
                                Margin="0,6,0,0"
                                FontSize="28"
                                FontWeight="Bold"
                                TextAlignment="Center"
                                Foreground="#6D5DF6"
                                Text="0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!--  만료됨  -->
                <Border
                    Grid.Column="4"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="54"
                            Height="54"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#FFF0F2"
                            CornerRadius="18">
                            <Image
                                Width="40"
                                Height="40"
                                Source="/Images/SubscriptionIcon/Expired.png"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#6B6380"
                                TextAlignment="Center"
                                Text="만료됨" />
                            <TextBlock
                                x:Name="ExpiredSubscriptionCountText"
                                Margin="0,6,0,0"
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="#D9365B"
                                TextAlignment="Center"
                                Text="0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!--  월 예상 매출  -->
                <Border
                    Grid.Column="6"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="54"
                            Height="54"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#F2F7FF"
                            CornerRadius="18">
                            <Image
                                Width="40"
                                Height="40"
                                Source="/Images/SubscriptionIcon/Total.png"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#6B6380"
                                TextAlignment="Center"
                                Text="월 예상 매출" />
                            <TextBlock
                                x:Name="MonthlyRevenueText"
                                Margin="0,6,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                TextAlignment="Center"
                                Foreground="#1E192D"
                                Text="₩ 0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!--  검색 / 필터 / 버튼  -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <!--  검색  -->
                <Border
                    Grid.Column="0"
                    Style="{StaticResource FilterBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#9B94A8"
                            Text="🔍" />
                        <TextBox
                            x:Name="SubscriptionSearchTextBox"
                            TextChanged="SubscriptionSearchTextBox_TextChanged"
                            Grid.Column="1"
                            Style="{StaticResource CleanTextBoxStyle}" />
                    </Grid>
                </Border>
                <!--  상태 필터  -->
                <Border
                    Grid.Column="2"
                    Style="{StaticResource FilterBoxStyle}">
                    <ComboBox
                        x:Name="SubscriptionStatusComboBox"
                        SelectedIndex="0"
                        SelectionChanged="SubScriptionFilterComboBox_SelectionChanged"
                        Style="{StaticResource CleanComboBoxStyle}">
                        <ComboBoxItem Content="상태 전체" />
                        <ComboBoxItem Content="활성" />
                        <ComboBoxItem Content="만료 임박" />
                        <ComboBoxItem Content="만료" />
                    </ComboBox>
                </Border>
                <!--  OTT 필터  -->
                <Border
                    Grid.Column="4"
                    Style="{StaticResource FilterBoxStyle}">
                    <ComboBox
                        x:Name="OttProviderFilterComboBox"
                        SelectionChanged="SubScriptionFilterComboBox_SelectionChanged"
                        DisplayMemberPath="OTT_Name"
                        SelectedValuePath="OTT_ID"
                        SelectedIndex="0"
                        Style="{StaticResource CleanComboBoxStyle}" />
                </Border>
                <!--  구독 추가  -->
                <Button
                    x:Name="AddSubscriptionButton"
                    Grid.Column="6"
                    Background="#6D5DF6"
                    BorderBrush="#6D5DF6"
                    Click="AddSubscriptionButton_Click"
                    Content="+ 구독 추가"
                    Foreground="White"
                    Style="{StaticResource ActionButtonStyle}" />
                <!--  CSV 추출  -->
                <Button
                    x:Name="ExportSubscriptionCsvButton"
                    Grid.Column="8"
                    Background="White"
                    BorderBrush="#C8B8FF"
                    Content="CSV 추출"
                    Foreground="#6D5DF6"
                    Click="ExportSubscriptionCsvButton_Click"
                    Style="{StaticResource ActionButtonStyle}" />
            </Grid>
            <!--  구독 목록 / 구독 추가 화면  -->
            <Border
                Grid.Row="6"
                Style="{StaticResource MainCardStyle}">
                <Grid>
                    <!--  =========================  -->
                    <!--  1. 구독 목록 화면  -->
                    <!--  =========================  -->
                    <Grid
                        x:Name="SubscriptionListPanel"
                        Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid
                            x:Name="SubscriptionDataGrid"
                            Grid.Row="0"
                            SelectionChanged="SubscriptionDataGrid_SelectionChange"
                            Style="{StaticResource SubscriptionDataGridStyle}">
                            <DataGrid.Columns>
                                <!--  Subscription ID  -->
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding Subscription_ID}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="Subscription&#xA;ID"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!--  User ID  -->
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding User_ID}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="User&#xA;ID"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!--  사용자명  -->
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding User_Name}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="사용자명"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!--  OTT 제공자  -->
                                <DataGridTemplateColumn Width="170">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock
                                            Text="OTT 제공자"
                                            TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Image
                                                    Width="22"
                                                    Height="22"
                                                    Margin="0,0,8,0"
                                                    Source="{Binding IconPath}"
                                                    Stretch="Uniform" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="#1E192D"
                                                    Text="{Binding OTT_Name}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!--  시작일  -->
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding StartedAtText}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="시작일"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!--  만료일  -->
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding ExpiredAtText}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="만료일"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!--  결제금액  -->
                                <DataGridTextColumn
                                    Width="110"
                                    Binding="{Binding PaidAmountText}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="결제금액"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!--  상태  -->
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding SubscriptionStatus}"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="상태"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!--  하단 버튼  -->
                        <StackPanel
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                x:Name="RenewSubscriptionButton"
                                Width="110"
                                Margin="12,0,0,0"
                                Background="White"
                                BorderBrush="#A7C7FF"
                                Content="1개월 갱신"
                                Foreground="#3B82E6"
                                IsEnabled="False"
                                Click="RenewSubscriptionButton_Click"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                x:Name="CancelSubscriptionButton"
                                Width="110"
                                Margin="12,0,0,0"
                                Background="White"
                                BorderBrush="#FFB8C8"
                                Content="해지"
                                Foreground="#D9365B"
                                IsEnabled="False"
                                Click="CancelSubscriptionButton_Click"
                                Style="{StaticResource ActionButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <!--  =========================  -->
                    <!--  2. 구독 추가 입력 화면  -->
                    <!--  =========================  -->
                    <Grid
                        x:Name="SubscriptionAddPanel"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  제목  -->
                        <StackPanel Grid.Row="0">
                            <TextBlock
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="구독 추가" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="14"
                                Foreground="#777184"
                                Text="사용자 ID, OTT 제공자, 시작일, 만료일, 결제금액을 입력합니다." />
                        </StackPanel>
                        <!--  입력 폼  -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  User ID  -->
                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="사용자 *" />
                                <Border Style="{StaticResource FilterBoxStyle}">
                                    <TextBox
                                        x:Name="AddUserSearchTextBox"
                                        Style="{StaticResource CleanTextBoxStyle}"
                                        TextChanged="AddUserSearchTextBox_TextChanged"
                                        PreviewKeyDown="AddUserSearchTextBox_PreviewKeyDown" />
                                </Border>
                                <ListBox
                                    x:Name="AddUserSearchResultListBox"
                                    Margin="0,6,0,0"
                                    MaxHeight="150"
                                    DisplayMemberPath="DisplayText"
                                    Visibility="Collapsed"
                                    PreviewKeyDown="AddUserSearchResultListBox_PreviewKeyDown"
                                    PreviewMouseLeftButtonUp="AddUserSearchResultListBox_PreviewMouseLeftButtonUp" />
                                <TextBlock
                                    x:Name="SelectedUserInfoText"
                                    Margin="0,6,0,0"
                                    FontSize="12"
                                    Foreground="#777184"
                                    Text="선택된 사용자 없음"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <!--  OTT 제공자  -->
                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#5F5870"
                                    Text="OTT 제공자 *" />
                                <Border Style="{StaticResource FilterBoxStyle}">
                                    <ComboBox
                                        x:Name="AddOttProviderComboBox"
                                        DisplayMemberPath="OTT_Name"
                                        SelectedValuePath="OTT_ID"
                                        SelectionChanged="AddOttProviderComboBox_SelectionChanged"
                                        Style="{StaticResource CleanComboBoxStyle}" />
                                </Border>
                            </StackPanel>
                            <!--  시작일  -->
                            <StackPanel Grid.Column="4">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#5F5870"
                                    Text="시작일 *" />
                                <DatePicker
                                    x:Name="AddStartedDatePicker"
                                    Height="42"
                                    FontSize="14"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    SelectedDateChanged="AddStartedDatePicker_SelectedDateChanged" />
                            </StackPanel>
                            <!--  만료일  -->
                            <StackPanel Grid.Column="6">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#5F5870"
                                    Text="만료일 *" />
                                <DatePicker
                                    x:Name="AddExpiredDatePicker"
                                    Height="42"
                                    FontSize="14"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    IsEnabled="False" />
                            </StackPanel>
                            <!--  결제금액  -->
                            <StackPanel Grid.Column="8">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#5F5870"
                                    Text="결제금액 *" />
                                <Border Style="{StaticResource FilterBoxStyle}">
                                    <TextBox
                                        x:Name="AddPaidAmountTextBox"
                                        FontWeight="SemiBold"
                                        Foreground="#6D5DF6"
                                        IsReadOnly="True"
                                        Style="{StaticResource CleanTextBoxStyle}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <!--  하단 버튼  -->
                        <StackPanel
                            Grid.Row="4"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                x:Name="BackToSubscriptionListButton"
                                Width="110"
                                Background="White"
                                BorderBrush="#CFC8DC"
                                Click="BackToSubscriptionListButton_Click"
                                Content="목록으로"
                                Foreground="#5F5870"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                x:Name="ResetAddSubscriptionButton"
                                Width="110"
                                Margin="12,0,0,0"
                                Background="White"
                                BorderBrush="#C8B8FF"
                                Click="ResetAddSubscriptionButton_Click"
                                Content="초기화"
                                Foreground="#6D5DF6"
                                Style="{StaticResource ActionButtonStyle}" />
                            <Button
                                x:Name="SaveAddSubscriptionButton"
                                Width="110"
                                Margin="12,0,0,0"
                                Background="#6D5DF6"
                                BorderBrush="#6D5DF6"
                                Content="저장"
                                Foreground="White"
                                Click="SaveAddSubscriptionButton_Click"
                                Style="{StaticResource ActionButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
