                                Margin="8,0,0,0"
                                Background="#6D5DF6"
                                BorderBrush="#6D5DF6"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="SaveEndWatchButton_Click" />
                        </StackPanel>
