                                        Style="{StaticResource ReadOnlyValueTextStyle}" />
                                </Border>
                            </StackPanel>
                            <!-- 시청 시간 -->
                            <StackPanel Grid.Column="6">
                                <TextBlock
                                    Text="시청 시간(분) *"
                                    Style="{StaticResource FormLabelStyle}" />
                                <Border Style="{StaticResource FilterBoxStyle}">
                                    <TextBox
                                        x:Name="EndWatchMinutesTextBox"
                                        Style="{StaticResource CleanTextBoxStyle}"
                                        TextChanged="EndWatchMinutesTextBox_TextChanged" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border
