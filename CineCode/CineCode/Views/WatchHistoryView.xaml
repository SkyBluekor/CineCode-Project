                            <!-- 콘텐츠 타입 -->
                            <StackPanel Grid.Column="4">
                                <TextBlock
                                    Text="콘텐츠 타입"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="#555"
                                    Margin="0,0,0,6" />
