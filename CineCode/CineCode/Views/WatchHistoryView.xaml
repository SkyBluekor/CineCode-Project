                            Margin="0,24,0,0"
                            Background="#F8F6FF"
                            BorderBrush="#E1D9FF"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="16"
                            VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Text="시청 시작 시간"
                                        FontSize="12"
                                        Foreground="#777184" />
                                    <TextBlock
                                        x:Name="EndStartedAtText"
                                        Text="-"
                                        Margin="0,6,0,0"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#1E192D" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Text="예상 진행률"
                                        FontSize="12"
                                        Foreground="#777184" />
                                    <TextBlock
                                        x:Name="EndExpectedProgressText"
                                        Text="-"
                                        Margin="0,6,0,0"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#6D5DF6" />
