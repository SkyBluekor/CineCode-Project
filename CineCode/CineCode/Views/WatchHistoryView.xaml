                                Width="92"
                                Margin="8,0,0,0"
                                Background="#6D5DF6"
                                BorderBrush="#6D5DF6"
                                Foreground="White"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="SaveStartWatchButton_Click" />
                        </StackPanel>
                    </Grid>
                    <!-- ========================= -->
                    <!-- 3. 시청 종료 처리 화면 -->
                    <!-- ========================= -->
                    <Grid
                        x:Name="WatchEndPanel"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
