<UserControl
    x:Class="CineCode.Views.WatchHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="756"
    d:DesignWidth="1000"
    FontFamily="/Fonts/#Pretendard">
    <UserControl.Resources>
        <!--  시청 기록 화면에서 공통으로 사용하는 카드, 필터, 버튼, 표, 입력 폼 스타일을 정의합니다.  -->
        <!--  상단 시청 기록 현황 요약 카드 스타일  -->
        <Style
            x:Key="SummaryCardStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="18" />
            <Setter
                Property="Padding"
                Value="16" />
            <Setter
                Property="BorderBrush"
                Value="#E7E1F1" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="0"
                        Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>
        <!--  시청 기록 목록, 시작, 종료, 수정 화면을 감싸는 메인 카드 스타일  -->
        <Style
            x:Key="MainCardStyle"
            TargetType="Border">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="18" />
            <Setter
                Property="Padding"
                Value="14" />
            <Setter
                Property="BorderBrush"
                Value="#E7E1F1" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        ShadowDepth="0"
                        Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>
        <!--  검색어 입력, 필터, 시청 기록 입력칸을 감싸는 박스 스타일  -->
        <Style
            x:Key="FilterBoxStyle"
            TargetType="Border">
            <Setter
                Property="Height"
                Value="38" />
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="CornerRadius"
                Value="10" />
            <Setter
                Property="BorderBrush"
                Value="#DED8EA" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="10,0" />
        </Style>
        <!--  기본 테두리를 제거한 입력 TextBox 스타일  -->
        <Style
            x:Key="CleanTextBoxStyle"
            TargetType="TextBox">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
            <Setter
                Property="CaretBrush"
                Value="#6D5DF6" />
        </Style>
        <!--  필터와 선택 입력에 사용하는 ComboBox 스타일  -->
        <Style
            x:Key="CleanComboBoxStyle"
            TargetType="ComboBox">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="Background"
                Value="Transparent" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
        </Style>
        <!--  날짜 입력 DatePicker 스타일  -->
        <Style
            x:Key="CleanDatePickerStyle"
            TargetType="DatePicker">
            <Setter
                Property="Height"
                Value="38" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="BorderBrush"
                Value="#DED8EA" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Background"
                Value="White" />
        </Style>
        <!--  조회, 시작, 종료, 수정, CSV 추출 버튼 공통 스타일  -->
        <Style
            x:Key="ActionButtonStyle"
            TargetType="Button">
            <Setter
                Property="Height"
                Value="38" />
            <Setter
                Property="MinWidth"
                Value="0" />
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Cursor"
                Value="Hand" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger
                                Property="IsMouseOver"
                                Value="True">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.88" />
                            </Trigger>
                            <Trigger
                                Property="IsEnabled"
                                Value="False">
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#ECEAF1" />
                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#ECEAF1" />
                                <Setter
                                    Property="Foreground"
                                    Value="#AAA4B5" />
                                <Setter
                                    Property="Cursor"
                                    Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  시청 기록 목록 DataGrid 스타일  -->
        <Style
            x:Key="WatchHistoryDataGridStyle"
            TargetType="DataGrid">
            <Setter
                Property="Background"
                Value="White" />
            <Setter
                Property="BorderBrush"
                Value="#E4DEEF" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="MinRowHeight"
                Value="40" />
            <Setter
                Property="HeadersVisibility"
                Value="Column" />
            <Setter
                Property="GridLinesVisibility"
                Value="Horizontal" />
            <Setter
                Property="HorizontalGridLinesBrush"
                Value="#EEEAF5" />
            <Setter
                Property="VerticalGridLinesBrush"
                Value="#EEEAF5" />
            <Setter
                Property="CanUserAddRows"
                Value="False" />
            <Setter
                Property="CanUserDeleteRows"
                Value="False" />
            <Setter
                Property="CanUserResizeRows"
                Value="False" />
            <Setter
                Property="AutoGenerateColumns"
                Value="False" />
            <Setter
                Property="IsReadOnly"
                Value="True" />
            <Setter
                Property="SelectionMode"
                Value="Single" />
            <Setter
                Property="SelectionUnit"
                Value="FullRow" />
            <Setter
                Property="FontSize"
                Value="12" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
            <Setter
                Property="HorizontalScrollBarVisibility"
                Value="Auto" />
            <Setter
                Property="VerticalScrollBarVisibility"
                Value="Auto" />
        </Style>
        <!--  DataGrid 헤더 스타일  -->
        <Style TargetType="DataGridColumnHeader">
            <Setter
                Property="Height"
                Value="38" />
            <Setter
                Property="Background"
                Value="#F5F2FB" />
            <Setter
                Property="Foreground"
                Value="#5F5870" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="FontSize"
                Value="11" />
            <Setter
                Property="HorizontalContentAlignment"
                Value="Center" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="BorderBrush"
                Value="#E4DEEF" />
            <Setter
                Property="BorderThickness"
                Value="0,0,1,1" />
        </Style>
        <!--  DataGrid 셀 스타일  -->
        <Style TargetType="DataGridCell">
            <Setter
                Property="BorderThickness"
                Value="0" />
            <Setter
                Property="TextBlock.TextAlignment"
                Value="Center" />
            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
            <Setter
                Property="Padding"
                Value="4,0" />
        </Style>
        <!--  가운데 정렬 셀 텍스트 스타일  -->
        <Style
            x:Key="CenterCellTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="TextAlignment"
                Value="Center" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
            <Setter
                Property="Padding"
                Value="4,3" />
        </Style>
        <!--  왼쪽 정렬 셀 텍스트 스타일  -->
        <Style
            x:Key="LeftCellTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="TextAlignment"
                Value="Left" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="TextWrapping"
                Value="Wrap" />
            <Setter
                Property="Padding"
                Value="6,3" />
        </Style>
        <!--  시청 기록 입력 폼 라벨 스타일  -->
        <Style
            x:Key="FormLabelStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="13" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="#5F5870" />
            <Setter
                Property="Margin"
                Value="0,0,0,8" />
        </Style>
        <!--  수정할 수 없는 시청 기록 값 표시 스타일  -->
        <Style
            x:Key="ReadOnlyValueTextStyle"
            TargetType="TextBlock">
            <Setter
                Property="FontSize"
                Value="14" />
            <Setter
                Property="FontWeight"
                Value="SemiBold" />
            <Setter
                Property="Foreground"
                Value="#1E192D" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
        </Style>
    </UserControl.Resources>
    <!--  시청 기록 관리 화면 전체 배경 영역  -->
    <Grid Background="#F8F9FC">
        <!--  제목, 요약 카드, 필터, 본문 카드를 배치하는 컨테이너  -->
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 제목 -->
            <StackPanel Grid.Row="0">
                <TextBlock
                    Text="Watch History"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#1E192D" />
                <TextBlock
                    Text="사용자의 시청 기록을 시작, 종료, 수정하고 진행 상태를 관리합니다."
                    Margin="0,6,0,0"
                    FontSize="14"
                    Foreground="#777184" />
            </StackPanel>
            <!-- 요약 카드 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!-- 총 시청 기록 -->
                <Border
                    Grid.Column="0"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="42"
                            Height="42"
                            Background="#EEF3FF"
                            CornerRadius="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Image
                                Source="/Images/WatchHistoryIcon/TotalWatchHistorycount.png"
                                Height="35"
                                Width="35"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="총 시청 기록"
                                FontSize="12"
                                FontWeight="SemiBold"
                                TextAlignment="Center"
                                Foreground="#6B6380" />
                            <TextBlock
                                x:Name="TotalWatchHistoryCountText"
                                Text="0"
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                TextAlignment="Center"
                                Foreground="#1E192D" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- 시청 완료 -->
                <Border
                    Grid.Column="2"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="42"
                            Height="42"
                            Background="#EFFFF6"
                            CornerRadius="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Image
                                Source="/Images/WatchHistoryIcon/WatchFinished.png"
                                Height="35"
                                Width="35"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="시청 완료"
                                FontSize="12"
                                FontWeight="SemiBold"
                                TextAlignment="Center"
                                Foreground="#6B6380" />
                            <TextBlock
                                x:Name="CompletedWatchCountText"
                                Text="0"
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                TextAlignment="Center"
                                Foreground="#28A970" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- 시청 중 -->
                <Border
                    Grid.Column="4"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="42"
                            Height="42"
                            Background="#FFF5DD"
                            CornerRadius="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Image
                                Source="/Images/WatchHistoryIcon/Watching.png"
                                Height="35"
                                Width="35"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="시청 중"
                                FontSize="12"
                                TextAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="#6B6380" />
                            <TextBlock
                                x:Name="WatchingCountText"
                                Text="0"
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                TextAlignment="Center"
                                Foreground="#F5A623" />
                        </StackPanel>
                    </Grid>
                </Border>
                <!-- 평균 시청률 -->
                <Border
                    Grid.Column="6"
                    Style="{StaticResource SummaryCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="42"
                            Height="42"
                            Background="#F4EEFF"
                            CornerRadius="14"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <Image
                                Source="/Images/WatchHistoryIcon/avgWatchRate.png"
                                Height="35"
                                Width="35"
                                Stretch="Uniform" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Text="평균 시청률"
                                FontSize="12"
                                TextAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="#6B6380" />
                            <TextBlock
                                x:Name="AverageProgressText"
                                Text="0%"
                                TextAlignment="Center"
                                Margin="0,4,0,0"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#1E192D" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- 검색 / 필터 / 상단 버튼 -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <!-- 검색 -->
                <Border
                    Grid.Column="0"
                    Style="{StaticResource FilterBoxStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="🔍"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Foreground="#A8DADC" />
                        <TextBox
                            x:Name="WatchHistorySearchTextBox"
                            Grid.Column="1"
                            TextChanged="WatchHistorySearchTextBox_TextChanged"
                            Style="{StaticResource CleanTextBoxStyle}" />
                    </Grid>
                </Border>
                <!-- 상태 필터 -->
                <Border
                    Grid.Column="2"
                    Style="{StaticResource FilterBoxStyle}">
                    <ComboBox
                        x:Name="WatchHistoryStatusFilterComboBox"
                        SelectionChanged="WatchHistoryFilterComboBox_SelectionChanged"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource CleanComboBoxStyle}"
                        SelectedIndex="0">
                        <ComboBoxItem Content="상태 전체" />
                        <ComboBoxItem Content="시청 중" />
                        <ComboBoxItem Content="완료" />
                        <ComboBoxItem Content="중단" />
                    </ComboBox>
                </Border>
                <!-- 콘텐츠 타입 필터 -->
                <Border
                    Grid.Column="4"
                    Style="{StaticResource FilterBoxStyle}">
                    <ComboBox
                        x:Name="WatchHistoryTypeFilterComboBox"
                        SelectionChanged="WatchHistoryFilterComboBox_SelectionChanged"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Style="{StaticResource CleanComboBoxStyle}"
                        SelectedIndex="0">
                        <ComboBoxItem Content="타입 전체" />
                        <ComboBoxItem Content="MOVIE" />
                        <ComboBoxItem Content="TV" />
                    </ComboBox>
                </Border>
                <!-- OTT 필터 -->
                <Border
                    Grid.Column="6"
                    Style="{StaticResource FilterBoxStyle}">
                    <ComboBox
                        x:Name="WatchHistoryOttFilterComboBox"
                        SelectionChanged="WatchHistoryFilterComboBox_SelectionChanged"
                        Style="{StaticResource CleanComboBoxStyle}"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        SelectedIndex="0">
                        <ComboBoxItem Content="OTT 전체" />
                    </ComboBox>
                </Border>
                <!-- 시청 시작 버튼 -->
                <Button
                    x:Name="StartWatchButton"
                    Grid.Column="8"
                    Content="+ 시작"
                    Width="92"
                    Background="#6D5DF6"
                    BorderBrush="#6D5DF6"
                    Foreground="White"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="StartWatchButton_Click" />
                <!-- CSV 추출 버튼 -->
                <Button
                    x:Name="ExportWatchHistoryCsvButton"
                    Grid.Column="10"
                    Content="CSV"
                    Width="74"
                    Background="White"
                    BorderBrush="#C8B8FF"
                    Foreground="#6D5DF6"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="ExportWatchHistoryCsvButton_Click" />
            </Grid>
            <!-- 본문 카드 -->
            <Border
                Grid.Row="6"
                Style="{StaticResource MainCardStyle}">
                <Grid>
                    <!-- ========================= -->
                    <!-- 1. 시청 기록 목록 화면 -->
                    <!-- ========================= -->
                    <Grid
                        x:Name="WatchHistoryListPanel"
                        Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DataGrid
                            x:Name="WatchHistoryDataGrid"
                            Grid.Row="0"
                            Style="{StaticResource WatchHistoryDataGridStyle}"
                            SelectionChanged="WatchHistoryDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <!-- Watch ID -->
                                <DataGridTextColumn
                                    Binding="{Binding Watch_ID}"
                                    Width="62"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="Watch&#xA;ID"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- User ID -->
                                <DataGridTextColumn
                                    Binding="{Binding User_ID}"
                                    Width="58"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="User&#xA;ID"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- 사용자명 -->
                                <DataGridTextColumn
                                    Binding="{Binding User_Name}"
                                    Width="120"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="사용자명"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- 콘텐츠명 -->
                                <DataGridTextColumn
                                    Binding="{Binding Content_Name}"
                                    Width="2*"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="콘텐츠명"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- Type -->
                                <DataGridTextColumn
                                    Binding="{Binding Content_Type}"
                                    Width="55"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="타입"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- OTT -->
                                <DataGridTextColumn
                                    Binding="{Binding OTT_Name}"
                                    Width="70"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="OTT"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- 시청 시작 -->
                                <DataGridTextColumn
                                    Binding="{Binding WatchStartedText}"
                                    Width="100"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="시청 시작"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- 시청 종료 -->
                                <DataGridTextColumn
                                    Binding="{Binding WatchEndedText}"
                                    Width="100"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="시청 종료"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- Watch Minutes / 시청 시간 -->
                                <DataGridTextColumn
                                    Binding="{Binding WatchMinutesText}"
                                    Width="72"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="시청&#xA;시간"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <!-- 진행률 -->
                                <DataGridTemplateColumn Width="95">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock
                                            Text="진행률"
                                            TextAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar
                                                    Grid.Column="0"
                                                    Height="7"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="{Binding ProgressPercentage}"
                                                    VerticalAlignment="Center" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding ProgressPercentText}"
                                                    FontSize="11"
                                                    Foreground="#5F5870"
                                                    TextAlignment="Right"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- 상태 -->
                                <DataGridTextColumn
                                    Binding="{Binding StatusText}"
                                    Width="62"
                                    ElementStyle="{StaticResource CenterCellTextStyle}">
                                    <DataGridTextColumn.Header>
                                        <TextBlock
                                            Text="상태"
                                            TextAlignment="Center" />
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <!-- 하단 버튼 -->
                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
