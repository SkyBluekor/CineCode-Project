                            </StackPanel>
                        </Grid>
                        <!-- 2행: OTT / 시작일 / 시작시간 -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
