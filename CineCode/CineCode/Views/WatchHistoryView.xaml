                                <Border Style="{StaticResource FilterBoxStyle}">
                                    <TextBox
                                        x:Name="EditWatchMinutesTextBox"
                                        Style="{StaticResource CleanTextBoxStyle}"
                                        TextChanged="EditWatchMinutesTextBox_TextChanged" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Border
                            Grid.Row="3"
                            Margin="0,24,0,0"
