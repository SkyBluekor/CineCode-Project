                                <StackPanel Grid.Column="4">
                                    <TextBlock
                                        Text="예상 진행률"
                                        FontSize="12"
                                        Foreground="#777184" />
                                    <TextBlock
                                        x:Name="EditExpectedProgressText"
                                        Text="-"
                                        Margin="0,6,0,0"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#6D5DF6" />
