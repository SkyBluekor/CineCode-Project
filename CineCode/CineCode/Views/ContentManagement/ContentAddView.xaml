<UserControl
    x:Class="CineCode.Views.ContentManagement.ContentAddView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CineCode.Views.ContentManagement"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="560"
    d:DesignWidth="1000"
    FontFamily="/Fonts/#Pretendard"
    mc:Ignorable="d">

    <!--  화면에서 공통으로 사용하는 스타일 모음  -->
    <UserControl.Resources>
        <!--  카드 스타일  -->
        <Style x:Key="AddCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderBrush" Value="#E6E1F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.08"
                        ShadowDepth="0" />
                </Setter.Value>
            </Setter>
        </Style>
        <!--  메인 버튼  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Background" Value="#6d5df6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#6D5DF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,0" />
        </Style>
        <!--  테두리 버튼  -->
        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6D5DF6" />
            <Setter Property="BorderBrush" Value="#6D5DF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F0EDFF" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E4DFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  입력 TextBox  -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#DDD7E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <!--  라벨  -->
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#4F485E" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!--  TMDB 전용 읽기 전용 TextBox  -->
        <Style
            x:Key="ReadOnlyTextBoxStyle"
            BasedOn="{StaticResource InputTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="#F4F1FA" />
            <Setter Property="Foreground" Value="#5F5870" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <!--  선택 목록 ListBox  -->
        <Style x:Key="SelectedListBoxStyle" TargetType="ListBox">
            <Setter Property="Height" Value="76" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="BorderBrush" Value="#DDD7E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#F8F9FC" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="DisplayMemberPath" Value="Name" />
        </Style>
        <!--  저장 버튼 전용 스타일  -->
        <Style x:Key="SaveButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Background" Value="#6D5DF6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#6D5DF6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,0" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#5A4DE8" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5A4DE8" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#483CCF" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#483CCF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--  콘텐츠 등록 화면 전체 레이아웃  -->
    <Grid Background="#f8F9FC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--  상단 제목  -->
        <Border
            Grid.Row="0"
            Padding="18,12"
            Background="White"
            BorderBrush="#E6E1F0"
            BorderThickness="1"
            CornerRadius="16">

            <StackPanel>
                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#1E192D"
                    Text="콘텐츠 등록" />
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="#777184"
                    Text="콘텐츠 정보를 직접 입력하거나 TMDB 검색으로 자동으로 채울 수 있습니다." />
            </StackPanel>
        </Border>

        <!--  본문  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  왼쪽: 선택 사항 TMDB 검색  -->
            <Border Grid.Column="0" Style="{StaticResource AddCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="160" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1E192D"
                            Text="선택 사항: TMDB 자동 채우기" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Foreground="#777184"
                            Text="검색 결과를 선택하면 오른쪽 입력 폼에 정보가 채워집니다."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!--  TMDB 검색 입력  -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="검색 제목" />

                            <TextBox x:Name="TmdbSearchTitleTextBox" Style="{StaticResource InputTextBoxStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="검색 타입" />
                            <ComboBox
                                x:Name="TmdbSearchTypeComboBox"
                                Height="30"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="21"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Movie" />
                                <ComboBoxItem Content="TV" />
                            </ComboBox>
                        </StackPanel>

                        <Button
                            x:Name="TmdbSearchButton"
                            Grid.Row="4"
                            Height="35"
                            Click="TmdbSearchButton_Click"
                            Content="TMDB 검색"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <!--  검색 결과  -->
                    <Border
                        Grid.Row="4"
                        Height="160"
                        Padding="12"
                        VerticalAlignment="Top"
                        Background="#F8F9FC"
                        CornerRadius="14">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="검색 결과" />

                            <ListBox
                                x:Name="TmdbResultListBox"
                                Grid.Row="2"
                                HorizontalContentAlignment="Stretch"
                                Background="Transparent"
                                BorderThickness="0"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                SelectionChanged="TmdbSearchResultListBox_SelectionChanged">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Padding="8"
                                            Background="White"
                                            BorderBrush="#E4DDF2"
                                            BorderThickness="1"
                                            CornerRadius="10">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="42" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Grid.Column="0"
                                                    Width="34"
                                                    Height="48"
                                                    Background="#EEEAF5"
                                                    ClipToBounds="True"
                                                    CornerRadius="6">

                                                    <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" />
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center">

                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="#1E192D"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />

                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="10"
                                                        Foreground="#777184"
                                                        Text="{Binding ReleaseDate}" />

                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="#6D5DF6"
                                                        Text="{Binding DisplayScore}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  오른쪽: 직접 입력 폼  -->
            <Border Grid.Column="2" Style="{StaticResource AddCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />

                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="#1E192D"
                                Text="콘텐츠 정보 입력" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="13"
                                Foreground="#777184"
                                Text="* 표시 항목은 필수 입력입니다." />
                        </StackPanel>

                        <!--  1줄: 제목/ 타입  -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource InputLabelStyle}" Text="Title *" />
                                <TextBox x:Name="TitleTextBox" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource InputLabelStyle}" Text="Type *" />
                                <ComboBox
                                    x:Name="ContentTypeComboBox"
                                    Height="42"
                                    Padding="12,0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    FontSize="14"
                                    SelectedIndex="0">
                                    <ComboBoxItem Content="Movie" />
                                    <ComboBoxItem Content="TV" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <!--  2줄: 출시일 / 러닝타임 / 관람등급  -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource InputLabelStyle}" Text="Release Date" />
                                <TextBox
                                    x:Name="ReleaseDateTextBox"
                                    Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource InputLabelStyle}" Text="Running Time" />
                                <TextBox
                                    x:Name="RunningTimeTextBox"
                                    Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource InputLabelStyle}" Text="Age Rating" />
                                <TextBox
                                    x:Name="AgeRatingTextBox"
                                    Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <!--  3줄: TMDB ID / 점수  -->
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource InputLabelStyle}" Text="TMDB ID" />
                                <TextBox x:Name="TmdbIdTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource InputLabelStyle}" Text="TMDB Score" />
                                <TextBox x:Name="TmdbScoreTextBox" Style="{StaticResource ReadOnlyTextBoxStyle}" />
                            </StackPanel>
                        </Grid>
                        <!--  4줄 : 장르  -->
                        <StackPanel Grid.Row="8">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="Genre" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <!--  DB에서 가져온 Genre 목록을 코드에서 ItemSource로 연결  -->
                                <ComboBox
                                    x:Name="GenreComboBox"
                                    Grid.Column="0"
                                    Height="42"
                                    Padding="12,0"
                                    VerticalContentAlignment="Center"
                                    DisplayMemberPath="Name"
                                    FontSize="14"
                                    SelectedValuePath="Id" />

                                <Button
                                    x:Name="AddGenreButton"
                                    Grid.Column="2"
                                    Height="42"
                                    Content="추가"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Click="AddGenreButton_Click" />

                                <Button
                                    x:Name="RemoveGenreButton"
                                    Grid.Column="4"
                                    Height="42"
                                    Content="제거"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Click="RemoveGenreButton_Click" />
                            </Grid>
                            <!--  선택된 Genre 목록  -->
                            <ListBox x:Name="SelectedGenreListBox" Style="{StaticResource SelectedListBoxStyle}" />
                        </StackPanel>

                        <!--  5줄: OTT Provider  -->
                        <StackPanel Grid.Row="10">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="OTT Provider" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <!--  DB에서 가져온 OTT 목록을 코드에서 ItemSource로 연결  -->
                                <ComboBox
                                    x:Name="OttProviderComboBox"
                                    Grid.Column="0"
                                    Height="42"
                                    Padding="12,0"
                                    VerticalContentAlignment="Center"
                                    DisplayMemberPath="Name"
                                    FontSize="14"
                                    SelectedValuePath="Id" />

                                <Button
                                    x:Name="AddOttProviderButton"
                                    Grid.Column="2"
                                    Height="42"
                                    Content="추가"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Click="AddOttProviderButton_Click" />

                                <Button
                                    x:Name="RemoveOttProviderButton"
                                    Grid.Column="4"
                                    Height="42"
                                    Content="제거"
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Click="RemoveOttProviderButton_Click" />
                            </Grid>
                            <ListBox x:Name="SelectedOttProviderListBox" Style="{StaticResource SelectedListBoxStyle}" />
                        </StackPanel>

                        <!--  6줄 : Poster URL  -->
                        <StackPanel Grid.Row="12">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="Poster URL" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="82" />
                                </Grid.ColumnDefinitions>

                                <TextBox
                                    x:Name="PosterUrlTextBox"
                                    Grid.Column="0"
                                    Style="{StaticResource InputTextBoxStyle}" />

                                <Border
                                    Grid.Column="2"
                                    Width="72"
                                    Height="96"
                                    Background="#F4F1FA"
                                    BorderBrush="#DDD7E8"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="8">

                                    <Image x:Name="PosterPreviewImage" Stretch="UniformToFill" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!--  7줄 : Overview  -->
                        <StackPanel Grid.Row="14">
                            <TextBlock Style="{StaticResource InputLabelStyle}" Text="OverView" />

                            <TextBox
                                x:Name="OverviewTextBox"
                                MinHeight="96"
                                Padding="12"
                                AcceptsReturn="True"
                                Background="White"
                                BorderBrush="#DDD7E8"
                                BorderThickness="1"
                                FontSize="14"
                                Foreground="#1E192D"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <!--  안내 문구  -->
                        <Border
                            Grid.Row="16"
                            Padding="12"
                            Background="#F8F9FC"
                            CornerRadius="12">
                            <TextBlock
                                FontSize="13"
                                Foreground="#777184"
                                Text="TMDB 검색을 사용하지 않아도 Title과 Type만 입력하면 수동 등록이 가능합니다. TMDB ID와 TMDB Score는 검색 결과 선택 시에만 자동 입력됩니다."
                                TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  하단 버튼  -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackToListButton"
                Grid.Column="1"
                Content="목록으로"
                Style="{StaticResource OutlineButtonStyle}"
                Click="BackToListButton_Click" />
            <Button
                x:Name="ClearButton"
                Grid.Column="3"
                Content="초기화"
                Style="{StaticResource OutlineButtonStyle}"
                Click="ClearButton_Click" />

            <Button
                x:Name="SaveButton"
                Grid.Column="5"
                Content="저장"
                Style="{StaticResource SaveButtonStyle}"
                Click="SaveButton_Click" />
        </Grid>
    </Grid>
</UserControl>
