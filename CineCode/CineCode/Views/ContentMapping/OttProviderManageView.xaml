<UserControl
    x:Class="CineCode.Views.ContentMapping.OttProviderManageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CineCode.Views.ContentMapping"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="460"
    d:DesignWidth="920"
    FontFamily="/Fonts/#Pretendard"
    mc:Ignorable="d">
    <UserControl.Resources>

        <!-- 내부 카드 스타일 -->
        <Style x:Key="InnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FBFAFE" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#EEE8F7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 라벨 스타일 -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5F5870" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <!-- 입력 박스 테두리 스타일 -->
        <Style x:Key="InputBoxBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderBrush" Value="#DED8EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- TextBox 스타일 -->
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1E192D" />
            <Setter Property="CaretBrush" Value="#3B82E6" />
        </Style>

        <!-- 버튼 공통 스타일 -->
        <Style x:Key="MappingActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ECEAF1" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#ECEAF1" />
                                <Setter Property="Foreground" Value="#AAA4B5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 스타일 -->
        <Style x:Key="MappingDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4DEEF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinRowHeight" Value="42" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEAF5" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEEAF5" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1E192D" />
        </Style>

        <!-- DataGrid 셀 텍스트 줄바꿈 스타일 -->
        <Style x:Key="WrapCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- OTT 이름 셀 스타일 -->
        <Style x:Key="OttNameCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,4" />
        </Style>

        <!-- DataGrid 헤더 기본 스타일 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#F2F7FF" />
            <Setter Property="Foreground" Value="#5F5870" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#E4DEEF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <!-- DataGrid 셀 기본 스타일 -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>

    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: OTT 제공자 추가/수정 -->
        <Border Grid.Column="0" Style="{StaticResource InnerCardStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 제목 -->
                <StackPanel Grid.Row="0">
                    <TextBlock
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#1E192D"
                        Text="OTT 제공자 추가 / 수정" />

                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="#81798F"
                        Text="OTT 이름과 월 구독료는 필수 입니다." />
                </StackPanel>

                <!-- OTT 이름 -->
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="OTT 이름 *" />

                    <Border Style="{StaticResource InputBoxBorderStyle}">
                        <TextBox
                            x:Name="OttNameTextBox"
                            Style="{StaticResource CleanTextBoxStyle}"
                            Text="" />
                    </Border>
                </StackPanel>

                <!-- 월 구독료 -->
                <StackPanel Grid.Row="4">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="월 구독료 *" />

                    <Border Style="{StaticResource InputBoxBorderStyle}">
                        <TextBox
                            x:Name="MonthlyPriceTextBox"
                            Style="{StaticResource CleanTextBoxStyle}"
                            Text="" />
                    </Border>
                </StackPanel>

                <!-- 버튼 -->
                <UniformGrid
                    Grid.Row="6"
                    Columns="4"
                    Rows="1">

                    <Button
                        x:Name="AddOttProviderButton"
                        Margin="0,0,7,0"
                        Background="#3B82E6"
                        BorderBrush="#3B82E6"
                        Content="추가"
                        Foreground="White"
                        Style="{StaticResource MappingActionButtonStyle}"
                        Click="AddOttProviderButton_Click" />

                    <Button
                        x:Name="UpdateOttProviderButton"
                        Margin="0,0,7,0"
                        Background="#ECEAF1"
                        BorderBrush="#ECEAF1"
                        Content="수정"
                        Foreground="#AAA4B5"
                        IsEnabled="False"
                        Style="{StaticResource MappingActionButtonStyle}"
                        Click="UpdateOttProviderButton_Click" />

                    <Button
                        x:Name="DeleteOttProviderButton"
                        Margin="0,0,7,0"
                        Background="#ECEAF1"
                        BorderBrush="#ECEAF1"
                        Content="삭제"
                        Foreground="#AAA4B5"
                        IsEnabled="False"
                        Style="{StaticResource MappingActionButtonStyle}"
                        Click="DeleteOttProviderButton_Click" />

                    <Button
                        x:Name="ClearOttProviderButton"
                        Background="White"
                        BorderBrush="#3B82E6"
                        Content="초기화"
                        Foreground="#3B82E6"
                        Style="{StaticResource MappingActionButtonStyle}"
                        Click="ClearOttProviderButton_Click" />
                </UniformGrid>

                <!-- 안내 문구 -->
                <Border
                    Grid.Row="8"
                    Margin="0,18,0,0"
                    Padding="14"
                    Background="#F2F7FF"
                    BorderBrush="#D8EAFE"
                    BorderThickness="1"
                    CornerRadius="12">
                    <TextBlock
                        FontSize="12"
                        Foreground="#5F6F8C"
                        LineHeight="19"
                        Text="목록에서 항목을 선택하면 수정/삭제 모드러 전환되고,   추가 버튼은 비활성화 됩니다."
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- 오른쪽: OTT 제공자 목록 -->
        <Border Grid.Column="2" Style="{StaticResource InnerCardStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 헤더 + 검색 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#1E192D"
                            Text="OTT 제공자 목록" />

                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="13"
                            Foreground="#81798F"
                            Text="등록된 OTT 제공자를 조회하고 선택할 수 있습니다." />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Height="40"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#DED8EA"
                        BorderThickness="1"
                        CornerRadius="11">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#A8DADC"
                                Text="🔍" />

                            <TextBox
                                x:Name="OttProviderSearchTextBox"
                                Grid.Column="1"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1E192D"
                                Text=""
                                TextChanged="OttProviderSearchTextBox_TextChanged" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- OTT 제공자 목록 DataGrid -->
                <Grid Grid.Row="2">
                    <DataGrid
                        x:Name="OttProviderDataGrid"
                        Style="{StaticResource MappingDataGridStyle}"
                        SelectionChanged="OttProviderDataGrid_SelectionChanged">
                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding OTT_ID}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="OTT&#x0a;ID"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding OTT_NAME}"
                                ElementStyle="{StaticResource OttNameCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="OTT NAME"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding monthly_price}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="Monthly&#x0a;price"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding LinkedContentCount}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="연결&#x0a;콘텐츠 수"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="90"
                                Binding="{Binding SubscriptionCount}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="구독수"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 하단 안내 -->
                <TextBlock
                    Grid.Row="4"
                    FontSize="13"
                    Foreground="#81798F"
                    Text="행을 선택하면 왼쪽 입력 폼에 값이 채워집니다." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
