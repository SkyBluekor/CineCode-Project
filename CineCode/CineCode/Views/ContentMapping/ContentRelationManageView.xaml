<UserControl
    x:Class="CineCode.Views.ContentMapping.ContentRelationManageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="460"
    d:DesignWidth="920"
    FontFamily="/Fonts/#Pretendard"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!-- 내부 카드 스타일 -->
        <Style x:Key="InnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FBFAFE" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="BorderBrush" Value="#EEE8F7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 입력 박스 스타일 -->
        <Style x:Key="InputBoxBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#DED8EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <!-- TextBox 스타일 -->
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1E192D" />
            <Setter Property="CaretBrush" Value="#6D5DF6" />
        </Style>

        <!-- 버튼 스타일 -->
        <Style x:Key="RelationButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ECEAF1" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#ECEAF1" />
                                <Setter Property="Foreground" Value="#AAA4B5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 스타일 -->
        <Style x:Key="RelationDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4DEEF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="31" />
            <Setter Property="MinRowHeight" Value="31" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEAF5" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEEAF5" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#1E192D" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>

        <!-- DataGrid 헤더 기본 스타일 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#F5F2FB" />
            <Setter Property="Foreground" Value="#514A63" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#E4DEEF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="2,0" />
        </Style>

        <!-- DataGrid 셀 기본 스타일 -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,0" />
        </Style>

        <!-- 가운데 정렬 셀 -->
        <Style x:Key="WrapCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- 왼쪽 정렬 셀 -->
        <Style x:Key="LeftWrapCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- 콘텐츠 목록 상태 셀 -->
        <Style x:Key="StatusCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 연결된 장르 / OTT 행 강조 스타일 -->
        <Style x:Key="LinkedRelationRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1E192D" />
            <Setter Property="FontWeight" Value="Normal" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLinked}" Value="True">
                    <Setter Property="Background" Value="#EAF2FF" />
                    <Setter Property="Foreground" Value="#2563EB" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE" />
                    <Setter Property="Foreground" Value="#1D4ED8" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 상단: 선택된 콘텐츠 정보 + 검색 -->
        <Border Grid.Row="0" Style="{StaticResource InnerCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#1E192D"
                        Text="콘텐츠 연결 관리" />

                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="11"
                        Foreground="#81798F"
                        Text="콘텐츠를 선택한 뒤 장르와 OTT 제공자 연결 정보를 관리합니다." />

                    <TextBlock
                        x:Name="SelectedContentInfoText"
                        Margin="0,8,0,0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#6D5DF6"
                        Text="선택된 콘텐츠 없음" />
                </StackPanel>

                <!-- 검색 -->
                <Border
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource InputBoxBorderStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#A8DADC"
                            Text="🔍" />

                        <TextBox
                            x:Name="ContentSearchTextBox"
                            Grid.Column="1"
                            Style="{StaticResource CleanTextBoxStyle}"
                            Text=""
                            TextChanged="ContentSearchTextBox_TextChanged" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 본문: 3개 카드 횡 구성 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- 콘텐츠 목록을 가장 넓게 -->
                <ColumnDefinition Width="1.65*" />

                <ColumnDefinition Width="12" />

                <!-- 장르 연결 -->
                <ColumnDefinition Width="0.8*" />

                <ColumnDefinition Width="12" />

                <!-- OTT 연결 -->
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <!-- 콘텐츠 목록 -->
            <Border Grid.Column="0" Style="{StaticResource InnerCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1E192D"
                            Text="콘텐츠 목록" />

                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="#81798F"
                            Text="연결 정보를 수정할 콘텐츠를 선택합니다." />
                    </StackPanel>

                    <DataGrid
                        x:Name="ContentDataGrid"
                        Grid.Row="2"
                        Style="{StaticResource RelationDataGridStyle}"
                        SelectionChanged="ContentDataGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="48"
                                Binding="{Binding Content_ID}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="ContentID"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="52"
                                Binding="{Binding Content_Type}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="Type"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="*"
                                MinWidth="130"
                                Binding="{Binding Title}"
                                ElementStyle="{StaticResource LeftWrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="Title"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="46"
                                Binding="{Binding GenreCount}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="Genre"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="46"
                                Binding="{Binding OttCount}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="OTT"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="82"
                                Binding="{Binding MappingStatus}"
                                ElementStyle="{StaticResource StatusCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="상태"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock
                        Grid.Row="4"
                        FontSize="11"
                        Foreground="#81798F"
                        Text="콘텐츠를 선택하면 오른쪽 연결 목록을 수정할 수 있습니다." />
                </Grid>
            </Border>

            <!-- 장르 연결 -->
            <Border Grid.Column="2" Style="{StaticResource InnerCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1E192D"
                            Text="장르 연결" />

                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="#81798F"
                            Text="연결된 항목은 파란색 표시." />
                    </StackPanel>

                    <DataGrid
                        x:Name="ContentGenreDataGrid"
                        Grid.Row="2"
                        Style="{StaticResource RelationDataGridStyle}"
                        RowStyle="{StaticResource LinkedRelationRowStyle}"
                        SelectionChanged="ContentGenreDataGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="95"
                                Binding="{Binding Genre_Name}"
                                ElementStyle="{StaticResource LeftWrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="Genre"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="48"
                                Binding="{Binding Content_Type}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="Type"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="58"
                                Binding="{Binding LinkStatus}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="상태"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <UniformGrid Grid.Row="4" Columns="2">
                        <Button
                            x:Name="LinkGenreButton"
                            Margin="0,0,5,0"
                            Background="#6D5DF6"
                            BorderBrush="#6D5DF6"
                            Content="장르 연결"
                            Foreground="White"
                            IsEnabled="False"
                            Style="{StaticResource RelationButtonStyle}"
                            Click="LinkGenreButton_Click" />

                        <Button
                            x:Name="UnlinkGenreButton"
                            Background="White"
                            BorderBrush="#6D5DF6"
                            Content="연결 해제"
                            Foreground="#6D5DF6"
                            IsEnabled="False"
                            Style="{StaticResource RelationButtonStyle}"
                            Click="UnlinkGenreButton_Click" />
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- OTT 연결 -->
            <Border Grid.Column="4" Style="{StaticResource InnerCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#1E192D"
                            Text="OTT 연결" />

                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="#81798F"
                            Text="연결된 항목은 파란색 표시." />
                    </StackPanel>

                    <DataGrid
                        x:Name="ContentOttDataGrid"
                        Grid.Row="2"
                        Style="{StaticResource RelationDataGridStyle}"
                        RowStyle="{StaticResource LinkedRelationRowStyle}"
                        SelectionChanged="ContentOttDataGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="95"
                                Binding="{Binding OTT_NAME}"
                                ElementStyle="{StaticResource LeftWrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="OTT"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="58"
                                Binding="{Binding monthly_price}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="Price"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="58"
                                Binding="{Binding LinkStatus}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="상태"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <UniformGrid Grid.Row="4" Columns="2">
                        <Button
                            x:Name="LinkOttButton"
                            Margin="0,0,5,0"
                            Background="#3B82E6"
                            BorderBrush="#3B82E6"
                            Content="OTT 연결"
                            Foreground="White"
                            IsEnabled="False"
                            Style="{StaticResource RelationButtonStyle}"
                            Click="LinkOttButton_Click" />

                        <Button
                            x:Name="UnlinkOttButton"
                            Background="White"
                            BorderBrush="#3B82E6"
                            Content="연결 해제"
                            Foreground="#3B82E6"
                            IsEnabled="False"
                            Style="{StaticResource RelationButtonStyle}"
                            Click="UnlinkOttButton_Click" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
