<UserControl
    x:Class="CineCode.Views.ContentMapping.GenreManageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CineCode.Views.ContentMapping"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="460"
    d:DesignWidth="920"
    FontFamily="/Fonts/#Pretendard"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 내부 카드 스타일 -->
        <Style x:Key="InnerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FBFAFE" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#EEE8F7" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 라벨 스타일 -->
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5F5870" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <!-- 입력 박스 테두리 스타일 -->
        <Style x:Key="InputBoxBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderBrush" Value="#DED8EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- TextBox 스타일 -->
        <Style x:Key="CleanTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1E192D" />
            <Setter Property="CaretBrush" Value="#6D5DF6" />
        </Style>

        <!-- ComboBox 스타일 -->
        <Style x:Key="CleanComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1E192D" />
        </Style>

        <!-- 버튼 공통 스타일 -->
        <Style x:Key="MappingActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#ECEAF1" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#ECEAF1" />
                                <Setter Property="Foreground" Value="#AAA4B5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid 스타일 -->
        <Style x:Key="MappingDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E4DEEF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinRowHeight" Value="42" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEAF5" />
            <Setter Property="VerticalGridLinesBrush" Value="#EEEAF5" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1E192D" />
        </Style>
        <!-- DataGrid 셀 텍스트 줄바꿈 스타일 -->
        <Style x:Key="WrapCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- 장르 이름 셀: 왼쪽 정렬 + 줄바꿈 -->
        <Style x:Key="GenreNameCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,4" />
        </Style>

        <!-- DataGrid 헤더 기본 스타일 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#F5F2FB" />
            <Setter Property="Foreground" Value="#5F5870" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#E4DEEF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>

        <!-- DataGrid 셀 기본 스타일 -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 장르 추가/수정 -->
        <Border Grid.Column="0" Style="{StaticResource InnerCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 제목 + TMDB 가져오기 버튼 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="125" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#1E192D"
                            Text="장르 추가 / 수정" />

                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="#81798F"
                            Text="장르 이름과 콘텐츠 타입은 필수입니다." />
                    </StackPanel>

                    <Button
                        x:Name="ImportTmdbGenreButton"
                        Grid.Column="1"
                        Height="34"
                        Margin="8,2,0,0"
                        VerticalAlignment="Top"
                        Background="#6D5DF6"
                        BorderBrush="#6D5DF6"
                        Content="TMDB 가져오기"
                        Foreground="White"
                        FontSize="12"
                        Style="{StaticResource MappingActionButtonStyle}"
                        Click="ImportTmdbGenreButton_Click" />
                </Grid>

                <!-- 장르 이름 -->
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="장르 이름 *" />

                    <Border Style="{StaticResource InputBoxBorderStyle}">
                        <TextBox
                            x:Name="GenreNameTextBox"
                            Style="{StaticResource CleanTextBoxStyle}"
                            Text="" />
                    </Border>
                </StackPanel>

                <!-- 콘텐츠 타입 -->
                <StackPanel Grid.Row="4">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="콘텐츠 타입 *" />

                    <Border Style="{StaticResource InputBoxBorderStyle}">
                        <ComboBox
                            x:Name="ContentTypeComboBox"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="20"
                            SelectedIndex="0"
                            Style="{StaticResource CleanComboBoxStyle}">
                            <ComboBoxItem Content="Movie" />
                            <ComboBoxItem Content="TV" />
                        </ComboBox>
                    </Border>
                </StackPanel>

                <!-- TMDB 장르 ID -->
                <StackPanel Grid.Row="6">
                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="TMDB 장르 ID (선택)" />

                    <Border Style="{StaticResource InputBoxBorderStyle}">
                        <TextBox
                            x:Name="TmdbGenreIdTextBox"
                            IsReadOnly="True"
                            Cursor="Arrow"
                            ToolTip="장르 이름과 콘텐츠 타입을 기준으로 TMDB에서 자동 매칭됩니다."
                            Style="{StaticResource CleanTextBoxStyle}" />
                    </Border>
                </StackPanel>

                <!-- 버튼 -->
                <UniformGrid
                    Grid.Row="8"
                    Margin="0,0,0,0"
                    Columns="4"
                    Rows="1">
                    <Button
                        x:Name="AddGenreButton"
                        Margin="0,0,7,0"
                        Background="#6D5DF6"
                        BorderBrush="#6D5DF6"
                        Content="추가"
                        Foreground="White"
                        Style="{StaticResource MappingActionButtonStyle}"
                        Click="AddGenreButton_Click" />

                    <Button
                        x:Name="UpdateGenreButton"
                        Margin="0,0,7,0"
                        Background="#ECEAF1"
                        BorderBrush="#EcEAF1"
                        Content="수정"
                        Foreground="#AAA4B5"
                        IsEnabled="False"
                        Style="{StaticResource MappingActionButtonStyle}"
                        Click="UpdateGenreButton_Click" />

                    <Button
                        x:Name="DeleteGenreButton"
                        Margin="0,0,7,0"
                        Background="#ECEAF1"
                        BorderBrush="#ECEAF1"
                        Content="삭제"
                        Foreground="#AAA4B5"
                        IsEnabled="False"
                        Style="{StaticResource MappingActionButtonStyle}"
                        Click="DeleteGenreButton_Click" />

                    <Button
                        x:Name="ClearGenreButton"
                        Background="White"
                        BorderBrush="#6D5DF6"
                        Content="초기화"
                        Foreground="#6D5DF6"
                        Style="{StaticResource MappingActionButtonStyle}"
                        Click="ClearGenreButton_Click" />
                </UniformGrid>

                <!-- 안내 문구 -->
                <Border
                    Grid.Row="10"
                    Margin="0,18,0,0"
                    Padding="14"
                    Background="#F5F1FF"
                    BorderBrush="#E7DFFF"
                    BorderThickness="1"
                    CornerRadius="12">

                    <TextBlock
                        FontSize="14"
                        Foreground="#6B6380"
                        LineHeight="19"
                        Text="목록에서 항목을 선택하면 수정/삭제 모드로 전환되고, 추가버튼은 비활성화됩니다."
                        TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- 오른쪽: 장르 목록 -->
        <Border Grid.Column="2" Style="{StaticResource InnerCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 헤더 + 검색 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#1E192D"
                            Text="장르 목록" />

                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="13"
                            Foreground="#81798F"
                            Text="등록된 장르를 조회하고 선택할 수 있습니다." />
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Height="40"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#DED8EA"
                        BorderThickness="1"
                        CornerRadius="11">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="#A8DADC"
                                Text="🔍" />

                            <TextBox
                                x:Name="GenreSearchTextBox"
                                Grid.Column="1"
                                VerticalContentAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Foreground="#1E192D"
                                TextChanged="GenreSearchTexBox_TextChanged" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 장르 목록 DataGrid -->
                <Grid Grid.Row="2">
                    <DataGrid
                        x:Name="GenreDataGrid"
                        Style="{StaticResource MappingDataGridStyle}"
                        SelectionChanged="GenreDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Genre_ID}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="Genre&#x0a;ID"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="95"
                                Binding="{Binding TMDB_Genre_ID}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="TMDB&#x0a;Genre ID"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="95"
                                Binding="{Binding Content_Type}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="Content&#x0a;Type"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Genre_Name}"
                                ElementStyle="{StaticResource GenreNameCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="Genre Name"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>

                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding LinkedContentCount}"
                                ElementStyle="{StaticResource WrapCellTextStyle}">
                                <DataGridTextColumn.Header>
                                    <TextBlock
                                        Text="연결&#x0a;콘텐츠 수"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- 하단 안내 -->
                <TextBlock
                    Grid.Row="4"
                    FontSize="13"
                    Foreground="#81798F"
                    Text="행을 선택하면 왼쪽 입력 폼에 값이 채워집니다." />
            </Grid>
        </Border>
    </Grid>
</UserControl>
